#!/usr/bin/env bash
# deploy [stack…] — take local repo changes all the way to RUNNING, in one shot.
#
# WHY THIS EXISTS: a change is not live until a 6-step chain completes, and the
# chain kept getting half-done (no login button, stale config, "I pushed but…"):
#   1. sopsgen apply        -> leaves an UNTRACKED .sops.env + a MODIFIED VPS secret
#   2. git add + commit      (the review gate)
#   3. git push forgejo main -> MISSED MOST OFTEN; stack-git-sync then pulls stale
#   4. nrs-vps               (only if headscale-vps/ changed)
#   4b. services-VM OS rebuild (only if nixos/ changed — host units like
#       stack-git-sync/decrypt live there, NOT in any stack; finding #79 sat
#       undeployed because this leg was missing from the chain)
#   5. stack-git-sync + decrypt-sops-envs on the VM (timers, ~1 min lag)
#   6. redeploy the stack    (Komodo #1120: push does NOT auto-deploy)
# Nothing told you a step was skipped. This drives all of it and REFUSES to
# proceed on an uncommitted or unpushed tree — the two silent gaps.
#
# Usage:
#   ./deploy                 # deploy exactly what changed since forgejo/main
#   ./deploy forgejo samba   # force-deploy named stacks (also re-runs sync+decrypt)
#   ./deploy --vps           # also nrs-vps even if auto-detect didn't fire
#   ./deploy --vm            # also rebuild the services-VM OS even if auto-detect didn't fire
# Run it AFTER `sopsgen apply` (if you added secrets) and `git commit`.
#
# 🚨 ORDER: the VPS leg runs BEFORE the services-VM stacks. That is correct for
# the common case (OIDC: the app redirects to a provider that must already
# exist) and BACKWARDS for anything where the VPS is the CLIENT of a
# services-VM endpoint — today that is VPS log shipping, whose Alloy would come
# up pushing at a vlogs-ingest vhost caddy has not served yet (docs/deploy.md
# §5.6 has the recipe: push by hand first, so CHANGED is empty and this leg
# stays quiet, then `./deploy <stacks>`, then `nrs-vps`). Note naming stacks
# does NOT suppress the VPS leg — it fires off the pushed diff, not off $STACKS.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
VM=idan@10.0.0.3
cd "$REPO"

say() { printf '\033[1;36m» %s\033[0m\n' "$*"; }
err() { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; }

FORCE_VPS=0
FORCE_VM=0
STACKS=()
for a in "$@"; do
  case "$a" in
    --vps) FORCE_VPS=1 ;;
    --vm)  FORCE_VM=1 ;;
    -*)    err "unknown flag: $a"; exit 2 ;;
    *)     STACKS+=("$a") ;;
  esac
done

# --- Gate 1: uncommitted tree (catches the untracked .sops.env from sopsgen) --
if [[ -n "$(git status --porcelain)" ]]; then
  err "uncommitted changes — commit them first (did 'sopsgen apply' leave an untracked .sops.env / a modified VPS secret?):"
  git status --short
  err "then re-run ./deploy"
  exit 1
fi

# --- Push (running deploy = intent to ship) ----------------------------------
BEFORE=$(git ls-remote forgejo refs/heads/main | cut -f1)
AFTER=$(git rev-parse HEAD)
if [[ "$BEFORE" != "$AFTER" ]]; then
  say "pushing ${BEFORE:0:12}..${AFTER:0:12} -> forgejo"
  git push forgejo main
else
  say "forgejo already at HEAD — nothing to push"
fi

# What did this delivery change? (empty when nothing was pushed)
CHANGED=$(git diff --name-only "$BEFORE" "$AFTER" 2>/dev/null || true)

# --- Auto-detect stacks + VPS from the delivered diff ------------------------
if [[ ${#STACKS[@]} -eq 0 ]]; then
  while IFS= read -r s; do [[ -n "$s" ]] && STACKS+=("$s"); done \
    < <(printf '%s\n' "$CHANGED" | sed -n 's#^stacks/\([^/]*\)/.*#\1#p' | sort -u)
fi

if [[ $FORCE_VPS -eq 1 ]] || printf '%s\n' "$CHANGED" | grep -q '^headscale-vps/'; then
  say "headscale-vps changed -> nrs-vps (Authentik / headscale / ACL)"
  nixos-rebuild switch --flake "$REPO/headscale-vps#headscale-vps" \
    --target-host idan@vps --use-remote-sudo
fi

# BEFORE the stack legs on purpose: a nixos/ change often alters the very
# units the stack leg drives (stack-git-sync, decrypt-sops-envs), and the
# forced sync below must run under the NEW unit — finding #79's fix is
# exactly this shape (the sync unit normalises file modes during the sync).
if [[ $FORCE_VM -eq 1 ]] || printf '%s\n' "$CHANGED" | grep -q '^nixos/'; then
  say "nixos/ changed -> services-VM OS rebuild (git-sync / decrypt / komodo-bootstrap units)"
  nixos-rebuild switch --flake "$REPO/nixos#services-vm" \
    --target-host "$VM" --use-remote-sudo
fi

if [[ ${#STACKS[@]} -eq 0 ]]; then
  say "no services-VM stacks changed — done."
  exit 0
fi

# --- VM: force sync + decrypt (no timer wait), redeploy, verify --------------
say "services-vm stacks: ${STACKS[*]}"
ssh "$VM" bash -s -- "${STACKS[@]}" <<'REMOTE'
set -u
sudo systemctl start stack-git-sync.service 2>/dev/null || true
sudo systemctl start decrypt-sops-envs.service 2>/dev/null || true
sleep 3
rc=0
for s in "$@"; do
  [ -f "/srv/stacks/$s/compose.yaml" ] || { echo "skip $s (no compose.yaml)"; continue; }
  echo "=== $s ==="
  ( cd "/srv/stacks/$s" && docker compose -p "$s" up -d ) || rc=1
  # Verify: every container either running or an init that exited 0.
  for c in $(cd "/srv/stacks/$s" && docker compose -p "$s" ps -a --format '{{.Name}}' 2>/dev/null); do
    st=$(docker inspect -f '{{.State.Status}}/{{.State.ExitCode}}' "$c" 2>/dev/null || echo "?/?")
    case "$st" in
      running/*|exited/0) : ;;
      *) rc=1; echo "  ✗ $c: $st"; docker logs "$c" 2>&1 | grep -iE 'FATAL|error|WARN' | tail -3 ;;
    esac
  done
done
exit $rc
REMOTE

say "deploy done. If this touched OIDC/Authentik and nrs-vps did NOT run above, run it — the button needs the provider on the VPS."
