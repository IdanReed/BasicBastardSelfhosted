// Headscale ACL policy. Loaded via modules/headscale.nix settings.policy.path;
// validate with `headscale policy check --file policy.hujson`.
//
// With a policy file loaded, traffic is DEFAULT-DENY. Rule 1 keeps the owner's
// own devices fully connected, so this file is behaviour-neutral until nodes
// are tagged, while giving guests somewhere to be constrained.
//
// "idan@" is the OIDC user headscale mints on first OIDC login. From-zero
// bring-up registers servers under a throwaway `bootstrap` user first
// (docs/bring-up.md §8), then re-registers them under `idan` (§14 step 4) —
// headscale cannot move a node between users.
// 🚨 NEVER name the bootstrap user `idan`: a second OIDC `idan` collides, the
// ambiguous `idan@` resolves to NEITHER, and every node loses tailnet access.
//
// Tags are applied at registration and cannot be added retroactively without
// re-registering:
//   tailscale up --login-server=https://headscale.idanreed.com \
//                --advertise-tags=tag:server
{
  // The services VM by address: no node advertises tags yet, so a tag:server
  // destination matches nothing. It keeps 100.64.0.2 across a re-registration
  // because it rejoins second (docs/bring-up.md §14 step 4).
  "hosts": {
    "services-vm": "100.64.0.2/32",
  },

  "tagOwners": {
    "tag:server": ["idan@"],
    "tag:guest": ["idan@"],
  },

  "acls": [
    // Owner's own devices, including subnet routes advertised by the OPNsense
    // router. Do not remove without another administrative path onto the
    // tailnet.
    {
      "action": "accept",
      "src": ["idan@"],
      "dst": ["*:*"],
    },

    // Metrics scraping, and the nightly pull of VPS state into the services
    // VM's backup set.
    {
      "action": "accept",
      "src": ["tag:server"],
      "dst": ["tag:server:*"],
    },

    // Invited users (every account but idan enrolls through invite-enrollment)
    // reach the services VM's Caddy on 443 only: no SSH, no direct container
    // ports, no LAN behind the subnet router.
    //
    // 🚨 :443 IS CADDY, and Caddy fronts every vhost. A headscale ACL is layer
    // 3; the per-vhost control is Authentik's: the admin tools and idan's
    // single-user apps are bound to the Admin group (forward-auth.yaml and the
    // Admin-bound *-oidc.yaml), and the apps whose first login claims
    // ownership must have been claimed by idan before the first invitation
    // (docs/accounts.md).
    {
      "action": "accept",
      "src": ["autogroup:member"],
      "dst": ["services-vm:443"],
    },

    // Guest devices, once tagged, get the same.
    {
      "action": "accept",
      "src": ["tag:guest"],
      "dst": ["services-vm:443"],
    },
  ],
}
