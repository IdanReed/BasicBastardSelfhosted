# VPS host secrets — plaintext TEMPLATE. The real file is secrets.sops.yaml,
# created once with:
#
#   cp secrets.sops.yaml.example secrets.sops.yaml
#   sops -e -i secrets.sops.yaml        # encrypts to the production recipient
#   sops secrets.sops.yaml              # then edit in the real values
#
# (Editing needs SOPS_AGE_KEY_FILE=../sops_age_key.txt; encrypting does not —
# encryption only uses the public key from .sops.yaml.)
#
# YAML rather than dotenv on purpose: sops-nix's sops-install-secrets applies
# the per-secret key only for yaml/json. With dotenv it writes the WHOLE
# decrypted file into every /run/secrets/<name> — which handed headscale a
# multi-line document as its OIDC client secret and tailscale an unusable auth
# key. Keys stay visible in the encrypted file; only values are encrypted.

# Preauth key for this VPS to join its own tailnet.
# Generate once Headscale is up: headscale preauthkeys create --user idan
TAILSCALE_AUTH_KEY: changeme_headscale_preauthkey

# PostgreSQL password for Authentik (generate: openssl rand -hex 32)
PG_PASS: changeme_generate_random_string

# Authentik secret key (generate: openssl rand -base64 36)
AUTHENTIK_SECRET_KEY: changeme_generate_with_openssl_rand

# OIDC client secret shared between Headscale and the Authentik blueprint
# (generate: openssl rand -hex 32)
HEADSCALE_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex

# OIDC client secret for Immich (generate: openssl rand -hex 32). The
# Authentik blueprint reads it via !Env; the SAME value must go into
# stacks/immich/.sops.env as IMMICH_OIDC_CLIENT_SECRET, where
# immich-config-init renders it into immich.json. Rotating it = edit both
# files + VPS nixos-rebuild switch + re-up the immich stack.
IMMICH_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex

# First-start bootstrap of the akadmin superuser + API token. Without these
# nobody can log in at all: the blueprint's idan user has no credential and no
# SMTP is configured for a reset link.
AUTHENTIK_BOOTSTRAP_PASSWORD: changeme_generate_with_openssl_rand
AUTHENTIK_BOOTSTRAP_TOKEN: changeme_generate_with_openssl_rand_hex
