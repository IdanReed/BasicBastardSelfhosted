# VPS host secrets — plaintext TEMPLATE for secrets.sops.yaml.
#   cp secrets.sops.yaml.example secrets.sops.yaml && sops -e -i secrets.sops.yaml
# Edit an existing file with `sopsedit`, never by regenerating from this one.
# YAML, not dotenv: sops-nix extracts per-key only for yaml/json.

# Tailnet
# headscale preauthkeys create -u <bootstrap-id> --reusable -e 24h
TAILSCALE_AUTH_KEY: changeme_headscale_preauthkey
# Previous preauth key, kept for rollback. No consumer; safe to drop.
TAILSCALE_AUTH_KEY_OLD: changeme_headscale_preauthkey

# Authentik
# openssl rand -hex 32
PG_PASS: changeme_hex32
# openssl rand -base64 36
AUTHENTIK_SECRET_KEY: changeme_base64_36
# First-start akadmin credential; without it nobody can log in at all.
AUTHENTIK_BOOTSTRAP_PASSWORD: changeme_strong_password
# openssl rand -hex 32
AUTHENTIK_BOOTSTRAP_TOKEN: changeme_hex32

# Headscale OIDC
# openssl rand -hex 32
HEADSCALE_OIDC_CLIENT_SECRET: changeme_hex32

# App OIDC client secrets, the per-user login passwords and the vlogs ingest
# token are NOT here: both hosts read them from secrets/shared.sops.json
# (secrets/shared.nix), so the VPS and the services VM can never disagree.
