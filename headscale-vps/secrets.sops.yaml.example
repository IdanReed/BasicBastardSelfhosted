# VPS host secrets — plaintext TEMPLATE for secrets.sops.yaml.
#   cp secrets.sops.yaml.example secrets.sops.yaml && sops -e -i secrets.sops.yaml
# Edit an existing file with `sopsedit`, never by regenerating from this one.
# YAML, not dotenv: sops-nix extracts per-key only for yaml/json.

# Tailnet
# headscale preauthkeys create -u <bootstrap-id> --reusable -e 24h
TAILSCALE_AUTH_KEY: changeme_headscale_preauthkey
# Previous preauth key, kept for rollback. No consumer; safe to drop.
TAILSCALE_AUTH_KEY_OLD: changeme_headscale_preauthkey

# Authentik
# openssl rand -hex 32
PG_PASS: changeme_hex32
# openssl rand -base64 36
AUTHENTIK_SECRET_KEY: changeme_base64_36
# First-start akadmin credential; without it nobody can log in at all.
AUTHENTIK_BOOTSTRAP_PASSWORD: changeme_strong_password
# openssl rand -hex 32
AUTHENTIK_BOOTSTRAP_TOKEN: changeme_hex32

# Headscale OIDC
# openssl rand -hex 32
HEADSCALE_OIDC_CLIENT_SECRET: changeme_hex32

# App OIDC
# One per native-OIDC app, read by blueprints/custom/<app>-oidc.yaml via !Env.
# Each has a twin in the stack's .sops.env — one value, both files, or login
# fails at token exchange. Filled by sops-gen. Generate each: openssl rand -hex 32
ABS_OIDC_CLIENT_SECRET: changeme_hex32
ACTUAL_OPENID_CLIENT_SECRET: changeme_hex32
BOOKSTACK_OIDC_CLIENT_SECRET: changeme_hex32
DAWARICH_OIDC_CLIENT_SECRET: changeme_hex32
EXCALIDRAW_OIDC_CLIENT_SECRET: changeme_hex32
FORGEJO_OIDC_CLIENT_SECRET: changeme_hex32
GHOSTFOLIO_OIDC_CLIENT_SECRET: changeme_hex32
HOMEBOX_OIDC_CLIENT_SECRET: changeme_hex32
IMMICH_OIDC_CLIENT_SECRET: changeme_hex32
KARAKEEP_OIDC_CLIENT_SECRET: changeme_hex32
KAVITA_OIDC_CLIENT_SECRET: changeme_hex32
MEALIE_OIDC_CLIENT_SECRET: changeme_hex32
# Outline has no local accounts — this secret IS the login.
OUTLINE_OIDC_CLIENT_SECRET: changeme_hex32
PAPERLESS_OIDC_CLIENT_SECRET: changeme_hex32
TANDOOR_OIDC_CLIENT_SECRET: changeme_hex32
VAULTWARDEN_OIDC_CLIENT_SECRET: changeme_hex32
WEALTHFOLIO_OIDC_CLIENT_SECRET: changeme_hex32

# User passwords
# Hand-set, human-memorable. Read by !Env in headscale-oidc.yaml; copy_only
# twins into Windmill + Samba (secrets-gen/manifest.yaml user/*).
IDAN_INITIAL_PASSWORD: changeme_memorable_passphrase
ALONDRA_INITIAL_PASSWORD: changeme_memorable_passphrase
CALE_INITIAL_PASSWORD: changeme_memorable_passphrase
ZACH_INITIAL_PASSWORD: changeme_memorable_passphrase
RYLAN_INITIAL_PASSWORD: changeme_memorable_passphrase
CAMERON_INITIAL_PASSWORD: changeme_memorable_passphrase
JUSTIN_INITIAL_PASSWORD: changeme_memorable_passphrase

# Log shipping
# Bearer this host's Alloy presents to vlogs-ingest.svc.idanreed.com. Twin of
# VLOGS_INGEST_TOKEN in stacks/caddy/.sops.env. openssl rand -hex 32
VLOGS_INGEST_TOKEN: changeme_hex32
