# VPS host secrets — plaintext TEMPLATE. The real file is secrets.sops.yaml,
# created once with:
#
#   cp secrets.sops.yaml.example secrets.sops.yaml
#   sops -e -i secrets.sops.yaml        # encrypts to the production recipient
#   sops secrets.sops.yaml              # then edit in the real values
#
# (Editing goes through `sopsedit` — the age key stays root-only at
# /var/lib/sops-nix; encrypting a fresh copy does not need the key at all —
# encryption only uses the public key from .sops.yaml.)
#
# YAML rather than dotenv on purpose: sops-nix's sops-install-secrets applies
# the per-secret key only for yaml/json. With dotenv it writes the WHOLE
# decrypted file into every /run/secrets/<name> — which handed headscale a
# multi-line document as its OIDC client secret and tailscale an unusable auth
# key. Keys stay visible in the encrypted file; only values are encrypted.

# Preauth key for this VPS to join its own tailnet.
# Generate once Headscale is up: headscale preauthkeys create --user idan
TAILSCALE_AUTH_KEY: changeme_headscale_preauthkey

# PostgreSQL password for Authentik (generate: openssl rand -hex 32)
PG_PASS: changeme_generate_random_string

# Authentik secret key (generate: openssl rand -base64 36)
AUTHENTIK_SECRET_KEY: changeme_generate_with_openssl_rand

# OIDC client secret shared between Headscale and the Authentik blueprint
# (generate: openssl rand -hex 32)
HEADSCALE_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex

# OIDC client secret for Immich (generate: openssl rand -hex 32). The
# Authentik blueprint reads it via !Env; the SAME value must go into
# stacks/immich/.sops.env as IMMICH_OIDC_CLIENT_SECRET, where
# immich-config-init renders it into immich.json. Rotating it = edit both
# files + VPS nixos-rebuild switch + re-up the immich stack.
IMMICH_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex

# OIDC client secret for Outline (generate: openssl rand -hex 32). The
# Authentik blueprint reads it via !Env; the SAME value must go into
# stacks/outline/.sops.env as OIDC_CLIENT_SECRET. Outline has NO local
# accounts — this secret IS the login. Rotating it = edit both files + VPS
# nixos-rebuild switch + re-up the outline stack.
OUTLINE_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex

# First-start bootstrap of the akadmin superuser + API token. Without these
# nobody can log in at all: the blueprint's idan user has no credential and no
# SMTP is configured for a reset link.
AUTHENTIK_BOOTSTRAP_PASSWORD: changeme_generate_with_openssl_rand
AUTHENTIK_BOOTSTRAP_TOKEN: changeme_generate_with_openssl_rand_hex

# --- OIDC client secrets, fleet rollout 2026-09-05 ------------------------
# One per native-OIDC app. Each is consumed by the matching
# blueprints/custom/<app>-oidc.yaml via !Env; the twin copy lives in the
# stack's .sops.env. Filled by sops-gen (secrets-gen/manifest.yaml).
# Generate each: openssl rand -hex 32
KAVITA_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
ABS_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
PAPERLESS_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
BOOKSTACK_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
HOMEBOX_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
KARAKEEP_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
DAWARICH_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
TANDOOR_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
MEALIE_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
VAULTWARDEN_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
GHOSTFOLIO_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
ACTUAL_OPENID_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
WEALTHFOLIO_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex
EXCALIDRAW_OIDC_CLIENT_SECRET: changeme_generate_with_openssl_rand_hex

# --- Per-user login passwords (rollout 2026-09-05) ------------------------
# Consumed by !Env in blueprints/custom/headscale-oidc.yaml (managed, re-asserted
# each apply). HAND-SET human-memorable values; copy_only twins to each user's
# Windmill + Samba account (secrets-gen/manifest.yaml user/*).
IDAN_INITIAL_PASSWORD: changeme_set_a_memorable_password
ALONDRA_INITIAL_PASSWORD: changeme_set_a_memorable_password
CALE_INITIAL_PASSWORD: changeme_set_a_memorable_password
ZACH_INITIAL_PASSWORD: changeme_set_a_memorable_password
RYLAN_INITIAL_PASSWORD: changeme_set_a_memorable_password
CAMERON_INITIAL_PASSWORD: changeme_set_a_memorable_password
JUSTIN_INITIAL_PASSWORD: changeme_set_a_memorable_password
