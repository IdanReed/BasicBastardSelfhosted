# VPS host secrets
# Copy to .sops.env and encrypt with:
#   SOPS_AGE_KEY_FILE=../sops_age_key.txt sops -e -i .sops.env
#
# All VPS secrets live in this one file now. Headscale and Authentik used to
# carry their own stacks/<name>/.sops.env decrypted on the host by stack-sync;
# sops-nix decrypts these at activation instead, so no plaintext .env is ever
# written to disk.

# Headscale preauth key for this VPS to join its own network.
# Generate once Headscale is up, on the VPS itself:
#   headscale users create idan
#   headscale preauthkeys create --user idan --reusable --expiration 24h
# This is a HEADSCALE key, not a Tailscale SaaS key — tailscale-autoconnect
# passes --login-server so it is presented to the right control plane.
TAILSCALE_AUTH_KEY=changeme_headscale_preauthkey

# PostgreSQL password for Authentik (generate: openssl rand -hex 32)
PG_PASS=changeme_generate_random_string

# Authentik secret key (generate: openssl rand -base64 36)
AUTHENTIK_SECRET_KEY=changeme_generate_with_openssl_rand

# OIDC client secret shared between Headscale and the Authentik blueprint
# (generate: openssl rand -hex 32)
HEADSCALE_OIDC_CLIENT_SECRET=changeme_generate_with_openssl_rand_hex

# First-start bootstrap of Authentik's `akadmin` superuser. Without these
# there is no way to log in: the blueprint's `idan` user has no credential and
# no SMTP is configured, so there is no password-reset path either.
# (generate: openssl rand -base64 36 / openssl rand -hex 32)
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme_generate_with_openssl_rand
AUTHENTIK_BOOTSTRAP_TOKEN=changeme_generate_with_openssl_rand_hex
