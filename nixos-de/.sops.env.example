# Desktop host secrets
# Copy to .sops.env and encrypt with:
#   SOPS_AGE_KEY_FILE=../sops_age_key.txt sops -e -i .sops.env

# User password hash. Generate with:
#   nix-shell -p mkpasswd --run 'mkpasswd -m sha-512'
# Wrap in single quotes so $ in the hash isn't expanded.
USER_PASSWORD_HASH='$6$replace$this$with$your$hash'
