# Desktop (nixos-de) OS secrets — plaintext TEMPLATE. The real file is
# secrets.sops.yaml, created once with:
#
#   cp secrets.sops.yaml.example secrets.sops.yaml
#   sops -e -i secrets.sops.yaml        # encrypts to the production recipient
#   sops secrets.sops.yaml              # then edit in the real values
#
# (Editing goes through `sopsedit` — the age key stays root-only at
# /var/lib/sops-nix; encrypting a fresh copy does not need the key at all —
# encryption only uses the public key from .sops.yaml.)
#
# YAML rather than dotenv on purpose: sops-nix's sops-install-secrets applies
# the per-secret key only for yaml/json — with dotenv it writes the WHOLE
# decrypted file into every /run/secrets/<name>. Keys stay visible in the
# encrypted file; only values are encrypted.
#
# ssh/<name> mirrors ssh-identities.nix one-to-one: each entry below is the
# private half of the identity of the same name (public halves live in
# ssh-pubkeys.nix). Paste each key with `sops secrets.sops.yaml` as a YAML
# block scalar (`github: |` + indented key lines).
ssh:
  github: changeme_github_ssh_private_key
  proxmox: changeme_proxmox_ssh_private_key
  arcane-vm: changeme_arcane-vm_ssh_private_key
  vps: changeme_vps_ssh_private_key
  storagebox: changeme_storagebox_ssh_private_key

# workvpn/* mirrors the params list in modules/nixos/work-vpn.nix one-to-one.
# These are secrets by EXPOSURE, not by capability: none grants access on its
# own, but together they map an employer's network and this repo is public.
#
# No password here on purpose — the gateway demands a second factor on every
# connect, so storing one buys nothing and puts a corporate credential at
# rest. openconnect prompts for password and MFA code interactively.
#
# To find `authgroup` (AnyConnect calls it the connection profile), run
# `openconnect --authenticate <gateway>` once: it lists the available groups
# before prompting for credentials.
#
# rdp_host must be the name as resolvable INSIDE the tunnel — ocproxy resolves
# it through the VPN's own DNS when the forward is set up.
#
# vpn_user and rdp_user are separate on purpose. AnyConnect is commonly driven
# by a UPN/email; RDP wants EITHER a bare sAMAccountName plus rdp_domain, OR a
# UPN with rdp_domain left empty — sending both is the one combination the
# server rejects, so workrdp omits /d: whenever rdp_user contains an '@'.
workvpn:
  gateway: changeme_vpn_gateway_fqdn
  vpn_user: changeme_vpn_login_often_an_email
  authgroup: changeme_anyconnect_tunnel_group
  rdp_host: changeme_windows_host_inside_tunnel
  rdp_user: changeme_rdp_login_bare_name_or_upn
  rdp_domain: changeme_ad_short_domain_or_empty_if_upn

# Future key (no consumer yet — breadcrumb from the retired .sops.env.example
# plan): declarative user password via users.users.idan.hashedPasswordFile +
# sops neededForUsers. Generate with `mkpasswd -m sha-512`; sops-yaml values
# need no $-quoting (that trap is the dotenv decrypt-and-source path only).
# USER_PASSWORD_HASH: changeme_sha512_crypt_hash
