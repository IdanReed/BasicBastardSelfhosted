# Desktop (nixos-de) OS secrets — plaintext TEMPLATE for secrets.sops.yaml.
#   cp secrets.sops.yaml.example secrets.sops.yaml && sops -e -i secrets.sops.yaml
# Edit an existing file with `sopsedit`, never by regenerating from this one.
# YAML, not dotenv: sops-nix extracts per-key only for yaml/json.

# SSH identities
# One entry per name in ssh-identities.nix; each value is that identity's
# ed25519 PRIVATE half, pasted as a YAML block scalar (`github: |`). Public
# halves live in ssh-pubkeys.nix.
# ssh-keygen -t ed25519 -N "" -f /tmp/<name> -C <name>
ssh:
  github: changeme_ed25519_private_block_scalar
  gatech: changeme_ed25519_private_block_scalar
  forgejo: changeme_ed25519_private_block_scalar
  proxmox: changeme_ed25519_private_block_scalar
  arcane-vm: changeme_ed25519_private_block_scalar
  vps: changeme_ed25519_private_block_scalar
  storagebox: changeme_ed25519_private_block_scalar

# Work VPN
# Mirrors the params list in modules/nixos/work-vpn.nix. Secrets by EXPOSURE,
# not capability — no password here; openconnect prompts for it plus MFA.
# `authgroup` is listed by: openconnect --authenticate <gateway>
# rdp_user + rdp_domain: bare sAMAccountName + domain, OR a UPN + empty domain.
workvpn:
  gateway: changeme_vpn_gateway_fqdn
  vpn_user: changeme_vpn_login_often_an_email
  authgroup: changeme_anyconnect_tunnel_group
  rdp_host: changeme_windows_host_inside_tunnel
  rdp_user: changeme_rdp_login_bare_name_or_upn
  rdp_domain: changeme_ad_short_domain_or_empty_if_upn

# Not wired yet: USER_PASSWORD_HASH (mkpasswd -m sha-512) for
# users.users.idan.hashedPasswordFile + sops neededForUsers.
