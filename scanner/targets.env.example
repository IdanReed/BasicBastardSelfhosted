# Scanner targets — shape only. REAL values live age-encrypted outside this
# public repo; provision.sh decrypts that file (SCANNER_TARGETS_SOPS) and
# writes ~/targets.env on the box.
#
# Dynamic rows (home WAN v4, home v6 prefix) are ISP-assigned — re-verify before
# each run:  curl -4 https://1.1.1.1/cdn-cgi/trace   (from the home LAN)
VPS_IP=203.0.113.10          # headscale VPS public IPv4
VPS_IP6=                     # empty if the VPS has no global IPv6
HOME_IP=198.51.100.20        # home WAN IPv4 (dynamic)
HOME_IP6_PREFIX=2001:db8::/64  # home IPv6 prefix (dynamic)
PVE_IP6=2001:db8::baca:3aff:fe6e:f401  # Proxmox WAN-side IPv6 (EUI-64, outside the firewall)
