# Cross-host secrets — the keys stored in secrets/shared.sops.json. Both hosts
# read them through secrets/shared.nix: the VPS's Authentik registers each OIDC
# client and its blueprint reads the per-user passwords (!Env), and the
# services VM renders the SAME values into each app's env via the stack's
# env.nix (`shared "<KEY>"`). One value, never a copy per host. Key set must
# match secrets/shared.sops.json and tests/fixtures/shared.sops.json.

# App OIDC
# One per native-OIDC app, read by blueprints/custom/<app>-oidc.yaml via !Env
# and by the app through its env.nix. Filled by sops-gen. openssl rand -hex 32
ABS_OIDC_CLIENT_SECRET=changeme_hex32
ACTUAL_OPENID_CLIENT_SECRET=changeme_hex32
BOOKSTACK_OIDC_CLIENT_SECRET=changeme_hex32
DAWARICH_OIDC_CLIENT_SECRET=changeme_hex32
EXCALIDRAW_OIDC_CLIENT_SECRET=changeme_hex32
FORGEJO_OIDC_CLIENT_SECRET=changeme_hex32
GRAFANA_OIDC_CLIENT_SECRET=changeme_hex32
PROFILARR_OIDC_CLIENT_SECRET=changeme_hex32
KOMODO_OIDC_CLIENT_SECRET=changeme_hex32
WINDMILL_OIDC_CLIENT_SECRET=changeme_hex32
WGER_OIDC_CLIENT_SECRET=changeme_hex32
BESZEL_OIDC_CLIENT_SECRET=changeme_hex32
CLEANUPARR_OIDC_CLIENT_SECRET=changeme_hex32
GHOSTFOLIO_OIDC_CLIENT_SECRET=changeme_hex32
HOMEBOX_OIDC_CLIENT_SECRET=changeme_hex32
IMMICH_OIDC_CLIENT_SECRET=changeme_hex32
KARAKEEP_OIDC_CLIENT_SECRET=changeme_hex32
KAVITA_OIDC_CLIENT_SECRET=changeme_hex32
MEALIE_OIDC_CLIENT_SECRET=changeme_hex32
# Outline has no local accounts — this secret IS the login.
OUTLINE_OIDC_CLIENT_SECRET=changeme_hex32
PAPERLESS_OIDC_CLIENT_SECRET=changeme_hex32
TANDOOR_OIDC_CLIENT_SECRET=changeme_hex32
VAULTWARDEN_OIDC_CLIENT_SECRET=changeme_hex32
WEALTHFOLIO_OIDC_CLIENT_SECRET=changeme_hex32

# User passwords
# Hand-set, human-memorable. Read by !Env in headscale-oidc.yaml, and by
# Windmill, Samba, Beszel and media (qBittorrent, Jellyfin) through their
# env.nix. Backrest's bcrypt and qBittorrent's PBKDF2 are hashes OF
# IDAN_INITIAL_PASSWORD, stored in their stacks: `sopsgen rotate user/idan`
# re-derives them after an edit here.
IDAN_INITIAL_PASSWORD=changeme_memorable_passphrase
ALONDRA_INITIAL_PASSWORD=changeme_memorable_passphrase
CALE_INITIAL_PASSWORD=changeme_memorable_passphrase
ZACH_INITIAL_PASSWORD=changeme_memorable_passphrase
RYLAN_INITIAL_PASSWORD=changeme_memorable_passphrase
CAMERON_INITIAL_PASSWORD=changeme_memorable_passphrase
JUSTIN_INITIAL_PASSWORD=changeme_memorable_passphrase

# Log shipping
# Bearer the VPS's Alloy presents to vlogs-ingest.svc.idanreed.com, and the one
# Caddy expects there (stacks/caddy/env.nix). openssl rand -hex 32
VLOGS_INGEST_TOKEN=changeme_hex32
