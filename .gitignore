*.claude
# Plaintext env files — nothing in the repo should ever hold one (stack envs
# are rendered on the host, into /run/stack-env)
**/.env

# Age private key (NEVER commit)
sops_age_key.txt

# Nix build outputs
result
nixos/result

# Test-run logs kept out of history (harness archaeology only)
/tmp/

# update-images.sh writes images.nix.tmp and renames it into place. A run that
# is killed (or a `git add -A` while one is in flight) leaves the tmp behind —
# and it got committed three times before this line existed.
tests/lib/images.nix.tmp

# Running a stack's init script locally compiles it, and two .pyc files got
# committed before these lines existed (run.sh's tracked-artifacts check now
# guards the whole class).
__pycache__/
*.pyc
