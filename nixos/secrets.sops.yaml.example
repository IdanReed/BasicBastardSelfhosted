# Services-VM host secrets — plaintext TEMPLATE for secrets.sops.yaml.
#   cp secrets.sops.yaml.example secrets.sops.yaml && sops -e -i secrets.sops.yaml
# Edit an existing file with `sopsedit`, never by regenerating from this one.
# YAML, not dotenv: sops-nix extracts per-key only for yaml/json.

# Tailnet
# On the VPS, under the BOOTSTRAP user (never `idan` — docs/bring-up.md §8):
# headscale preauthkeys create -u <bootstrap-id> --reusable -e 24h
TAILSCALE_AUTH_KEY: changeme_headscale_preauthkey
# Previous preauth key, kept for rollback. No consumer; safe to drop.
TAILSCALE_AUTH_KEY_OLD: changeme_headscale_preauthkey

# SSH identities
# Full ed25519 PRIVATE keys, pasted as YAML block scalars (`KEY: |`). Public
# halves go into ssh-pubkeys.nix (all three copies).
# ssh-keygen -t ed25519 -N "" -f /tmp/<name> -C <name>

# services VM -> VPS state pull (backup-prepare.sh).
BACKUP_VPS_SSH_KEY: changeme_ed25519_private_block_scalar
# backrest -> Hetzner Storage Box; authorise with
# ssh-copy-id -p 23 -i <pubkey> uXXXXXX@uXXXXXX.your-storagebox.de
BACKUP_STORAGEBOX_SSH_KEY: changeme_ed25519_private_block_scalar

# Forge credentials for the CI half of this host. Both are minted by Forgejo
# once it is live, so `changeme_` is their normal state until then: each
# consumer is SKIPPED (an ExecCondition), never failed, while it is one.
# Rendered into the EnvironmentFile each unit wants by renovate.nix and
# forgejo-runner.nix; a switch carries a new value to them.
#
# Renovate's PAT, for the Renovate bot user. Scopes (Forgejo 16 model):
# read:user, write:issue, write:repository — nothing more. For Renovate's OWN
# API calls; never used by a workflow to push (see the loop-prevention comment
# in .forgejo/workflows/renovate-pins.yml).
#   Forgejo -> Settings -> Applications -> Generate New Token
RENOVATE_TOKEN: changeme_forgejo_renovate_pat
# Actions runner registration token. ONE-SHOT — act_runner trades it for a
# durable credential in /var/lib/gitea-runner/forgejo/.runner and never uses it
# again; changing it re-registers nothing unless .runner is gone or the labels
# changed.
#   Forgejo -> Site Administration -> Actions -> Runners -> Create new runner
FORGEJO_RUNNER_TOKEN: changeme_forgejo_runner_registration_token
