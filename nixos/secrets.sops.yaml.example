# Services-VM host secrets — plaintext TEMPLATE. The real file is
# secrets.sops.yaml, created once with:
#
#   cp secrets.sops.yaml.example secrets.sops.yaml
#   sops -e -i secrets.sops.yaml        # encrypts to the production recipient
#   sops secrets.sops.yaml              # then edit in the real values
#
# YAML rather than dotenv on purpose: sops-nix's sops-install-secrets applies
# the per-secret key only for yaml/json; with dotenv every /run/secrets/<name>
# receives the WHOLE decrypted file. See .sops.yaml at the repo root.
#
# This replaces the host keys of the old .sops.env. Its other keys are gone on
# purpose: SSH_AUTHORIZED_KEY and SOPS_AGE_KEY had no consumer anywhere —
# build_proxmox.sh reads ../sops_age_key.txt directly.

# Preauth key for this host to join the Headscale tailnet.
# Generate on the VPS: headscale preauthkeys create --user idan
TAILSCALE_AUTH_KEY: changeme_headscale_preauthkey

# Host SSH identities (see ssh-pubkeys.nix). Each value is a full ed25519
# PRIVATE key — use a YAML block scalar when filling in the real one:
#
#   ssh-keygen -t ed25519 -N "" -f /tmp/backup-vps -C backup-vps
#   sops nixos/secrets.sops.yaml     # paste the private half as `KEY: |` block
#
# then put the .pub line into ssh-pubkeys.nix (ALL THREE copies) under the
# matching identity name. backup-prepare.sh refuses to use a key that is
# still a changeme_ placeholder, so a deploy before the real value is filled
# in fails loudly instead of registering garbage.

# backup-vps: services VM -> VPS state pull (backup-prepare.sh).
# Public half: ssh-pubkeys.nix `backup-vps`, authorised on the VPS.
BACKUP_VPS_SSH_KEY: changeme_backup_vps_ssh_private_key

# backup-storagebox: backrest -> Hetzner Storage Box (mounted into the
# container as /root/.ssh/id_ed25519). Public half: ssh-pubkeys.nix
# `backup-storagebox`, authorised on the box:
#   ssh-copy-id -p 23 -i <pubkey> uXXXXXX@uXXXXXX.your-storagebox.de
BACKUP_STORAGEBOX_SSH_KEY: changeme_backup_storagebox_ssh_private_key

# stack-git-sync: ed25519 PRIVATE key (YAML block scalar) the host uses to
# pull the compose repo over loopback SSH (ssh://git@127.0.0.1:10551) for
# Komodo's files_on_host delivery. SSH since 2026-09 — replaces the v1
# read:repository token: the key exists before Forgejo does, so no
# placeholder+rebuild dance at bring-up. Consumed via GIT_SSH_COMMAND, never
# argv. Filled by sops-gen (secrets-gen/manifest.yaml); the PUBLIC half
# (ssh-keygen -y on the decrypted private) is pasted into the repo's
# Settings -> Deploy keys as READ-ONLY once Forgejo is up (deploy-handbook §6).
STACK_GIT_SSH_KEY: changeme_forgejo_deploy_ssh_private_key
