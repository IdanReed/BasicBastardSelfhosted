# Services-VM host secrets — plaintext TEMPLATE for secrets.sops.yaml.
#   cp secrets.sops.yaml.example secrets.sops.yaml && sops -e -i secrets.sops.yaml
# Edit an existing file with `sopsedit`, never by regenerating from this one.
# YAML, not dotenv: sops-nix extracts per-key only for yaml/json.

# Tailnet
# On the VPS, under the BOOTSTRAP user (never `idan` — deploy-handbook §4/§8.1):
# headscale preauthkeys create -u <bootstrap-id> --reusable -e 24h
TAILSCALE_AUTH_KEY: changeme_headscale_preauthkey
# Previous preauth key, kept for rollback. No consumer; safe to drop.
TAILSCALE_AUTH_KEY_OLD: changeme_headscale_preauthkey

# SSH identities
# Full ed25519 PRIVATE keys, pasted as YAML block scalars (`KEY: |`). Public
# halves go into ssh-pubkeys.nix (all three copies).
# ssh-keygen -t ed25519 -N "" -f /tmp/<name> -C <name>

# services VM -> VPS state pull (backup-prepare.sh).
BACKUP_VPS_SSH_KEY: changeme_ed25519_private_block_scalar
# backrest -> Hetzner Storage Box; authorise with
# ssh-copy-id -p 23 -i <pubkey> uXXXXXX@uXXXXXX.your-storagebox.de
BACKUP_STORAGEBOX_SSH_KEY: changeme_ed25519_private_block_scalar
# stack-git-sync -> Forgejo over loopback. Public half goes into the repo's
# Settings -> Deploy keys as READ-ONLY (deploy-handbook §6).
STACK_GIT_SSH_KEY: changeme_ed25519_private_block_scalar
