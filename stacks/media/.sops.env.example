# Media stack secrets (services VM)
# Copy to .sops.env, fill, then `sops -e -i .sops.env` — encrypting a NEW
# file needs only the pubkey in .sops.yaml (no age key, no sudo);
# editing later goes through `sopsedit` (see CLAUDE.md).
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/media.sops.env must all carry EXACTLY the same keys — the
# stack-env-drift lint fails on any difference. Adding a gluetun variable for
# your provider therefore means adding it to all three (fixture value: a
# harmless dummy that keeps the tunnel DOWN).
#
# Reminder from CLAUDE.md: any value containing '$' must be single-quoted in
# the plaintext before encrypting — the decrypt-and-source path expands it
# otherwise. (None of the generate commands below emit '$'.)

# ---------------------------------------------------------------------------
# Servarr API keys — pushed DOWN into each app via the {APP}__AUTH__APIKEY
# env override (https://wiki.servarr.com/radarr/environment-variables), so
# media-init, Prowlarr and the suite all know them a priori. 32 hex chars,
# matching what the apps self-generate.
# Generate each: openssl rand -hex 16
# ---------------------------------------------------------------------------
RADARR__AUTH__APIKEY=changeme_32_hex_chars
SONARR__AUTH__APIKEY=changeme_32_hex_chars
PROWLARR__AUTH__APIKEY=changeme_32_hex_chars

# Profilarr API key — its docs require >= 32 chars.
# Generate: openssl rand -hex 32
PROFILARR_API_KEY=changeme_64_hex_chars

# ---------------------------------------------------------------------------
# qBittorrent WebUI credentials. The PLAINTEXT password is what Radarr/Sonarr
# use to talk to qbit's API (media-init wires it); the PBKDF2 line is the
# same password in the qBittorrent.conf storage format, seeded once by
# qbit-init. Derive PBKDF2 FROM the password — the two must match:
#
#   python3 - 'the-same-password' <<'EOF'
#   import base64, hashlib, os, sys
#   salt = os.urandom(16)
#   dk = hashlib.pbkdf2_hmac('sha512', sys.argv[1].encode(), salt, 100000, 64)
#   print("@ByteArray(%s:%s)" % (base64.b64encode(salt).decode(),
#                                base64.b64encode(dk).decode()))
#   EOF
# ---------------------------------------------------------------------------
QBIT_WEBUI_USER=changeme_username
QBIT_WEBUI_PASSWORD=changeme_password
QBIT_WEBUI_PASSWORD_PBKDF2=@ByteArray(changeme_salt_b64:changeme_hash_b64)

# ---------------------------------------------------------------------------
# Gluetun — PROVIDER-AGNOSTIC block (locked decision): the compose file
# hardcodes nothing about any provider; everything below flows straight into
# the gluetun container. Fill in ONLY what YOUR provider needs and leave the
# rest empty (gluetun treats empty as unset). Full per-provider reference:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# ---------------------------------------------------------------------------

# Always required. Examples: protonvpn, private internet access, airvpn,
# mullvad, custom.
VPN_SERVICE_PROVIDER=changeme_provider
# wireguard or openvpn — decides which credential group below is used.
VPN_TYPE=wireguard

# --- wireguard providers (and VPN_TYPE=wireguard generally) ---
# From your provider's generated config. Key generation (custom setups):
#   wg genkey | tee private.key | wg pubkey
WIREGUARD_PRIVATE_KEY=changeme_wg_private_key_b64
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=changeme_e.g._10.2.0.2/32

# --- custom provider only (VPN_SERVICE_PROVIDER=custom): the peer ---
WIREGUARD_PUBLIC_KEY=
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=

# --- openvpn providers (VPN_TYPE=openvpn) ---
OPENVPN_USER=
OPENVPN_PASSWORD=

# --- server selection (most named providers; ignored by custom) ---
SERVER_COUNTRIES=changeme_e.g._Netherlands

# Port forwarding: on ONLY if the provider supports it (PIA/Proton/AirVPN
# class — Mullvad removed it). When on, gluetun's UP_COMMAND (compose.yaml)
# pushes the forwarded port into qbit automatically. off = passive peering.
VPN_PORT_FORWARDING=off
