# Media — the keys stored in secrets.sops.json, one value each (`sopsgen
# apply` fills generated ones, `sopsedit` the rest). Values built from other
# secrets live in env.nix. Key set must match secrets.sops.json and
# tests/fixtures/stacks/media.sops.json.
# A gluetun variable added for your provider goes into all three.

# Servarr
# Pushed into each app via {APP}__AUTH__APIKEY, so media-init, Prowlarr and the
# suite all know them a priori. 32 hex chars. openssl rand -hex 16
RADARR__AUTH__APIKEY=changeme_hex32
SONARR__AUTH__APIKEY=changeme_hex32
PROWLARR__AUTH__APIKEY=changeme_hex32
# Profilarr's docs require >= 32 chars. openssl rand -hex 32
PROFILARR_API_KEY=changeme_hex64

# qBittorrent
# The PLAINTEXT password is what Radarr/Sonarr use against qbit's API; the
# PBKDF2 line is the same password in qBittorrent.conf format, seeded once by
# qbit-init. Derive the second FROM the first — `sopsgen rotate user/idan` does
# both. By hand: PBKDF2-HMAC-SHA512, 100k iters, 64-byte dk, as
# @ByteArray(salt_b64:dk_b64).
QBIT_WEBUI_USER=changeme_username
QBIT_WEBUI_PASSWORD_PBKDF2=@ByteArray(changeme_salt_b64:changeme_hash_b64)

# Jellyfin
# The first admin, created headlessly by jellyfin-init over /Startup/*, which
# is anonymous ONLY while the setup wizard is open.
# 🚨 Also what SEERR authenticates against, so it is idan's one memorable
# password (a secrets-gen user/idan copy_only twin), not a generated value.
# ⚠ Jellyfin has NO headless password reset: `sopsgen rotate user/idan`
# changes what jellyfin-init LOGS IN with, not what Jellyfin stores, and the
# next deploy then fails loudly. Reset in the UI first, or wipe
# /mnt/fast/jellyfin/config.
JELLYFIN_ADMIN_USER=idan

# Seerr
# Seerr's own API key: compose hands it to seerr as API_KEY (which forces
# main.apiKey on every load); the init sidecars read it under this name.
# openssl rand -hex 32
SEERR_API_KEY=changeme_hex64
# Recorded on seerr's user 1; notifications only, the login is the Jellyfin
# account above.
SEERR_ADMIN_EMAIL=changeme@example.com

# Bazarr
# Bazarr's own auth.apikey, pinned by bazarr-config-init. The default is a
# random 16 bytes nobody can know, which would leave the API unreachable.
# openssl rand -hex 16
BAZARR_API_KEY=changeme_hex32

# Gluetun
# Provider-agnostic by design: compose hardcodes nothing, everything below
# flows straight into the container. Fill ONLY what YOUR provider needs and
# leave the rest empty (gluetun treats empty as unset).
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=changeme_provider
VPN_TYPE=wireguard

# Gluetun wireguard
# From the provider's generated config. Custom setups: wg genkey | tee private.key | wg pubkey
WIREGUARD_PRIVATE_KEY=changeme_wg_private_key_b64
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=changeme_e.g._10.2.0.2/32

# Gluetun custom peer
# VPN_SERVICE_PROVIDER=custom only.
WIREGUARD_PUBLIC_KEY=
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=

# Gluetun openvpn
# VPN_TYPE=openvpn only.
OPENVPN_USER=
OPENVPN_PASSWORD=

# Gluetun server choice
# Named providers only; ignored by custom.
SERVER_COUNTRIES=changeme_e.g._Netherlands
# on ONLY if the provider supports it (PIA/Proton/AirVPN class). When on,
# gluetun's UP_COMMAND pushes the forwarded port into qbit.
VPN_PORT_FORWARDING=off
