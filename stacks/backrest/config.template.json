{
  "instance": "services-vm",
  "version": 4,
  "auth": {
    "disabled": false,
    "users": [
      {
        "name": "admin",
        "passwordBcrypt": "${BACKREST_ADMIN_PASSWORD_BCRYPT}"
      }
    ]
  },
  "repos": [
    {
      "id": "hetzner",
      "uri": "sftp:storagebox:/home/restic",
      "password": "${RESTIC_PASSWORD}",
      "env": [],
      "flags": [],
      "autoUnlock": false,
      "autoInitialize": true,
      "commandPrefix": {
        "ioNice": "IO_BEST_EFFORT_LOW",
        "cpuNice": "CPU_LOW"
      },
      "prunePolicy": {
        "schedule": {
          "cron": "0 4 * * 0",
          "clock": "CLOCK_LOCAL"
        },
        "maxUnusedPercent": 25
      },
      "checkPolicy": {
        "schedule": {
          "cron": "0 5 1 * *",
          "clock": "CLOCK_LOCAL"
        },
        "readDataSubsetPercent": 5
      },
      "hooks": [
        {
          "conditions": ["CONDITION_ANY_ERROR"],
          "onError": "ON_ERROR_IGNORE",
          "actionWebhook": {
            "webhookUrl": "http://ntfy/backups?priority=high&tags=rotating_light",
            "method": "POST",
            "template": "Repository error on {{ .Repo.Id }}: {{ .Error }}"
          }
        }
      ]
    }
  ],
  "plans": [
    {
      "id": "fast-volume",
      "repo": "hetzner",
      "paths": ["/mnt/fast"],
      "excludes": [
        "**/docker/**",
        "**/pgdata/**",
        "**/postgresql/**",
        "**/cache/**",
        "**/Cache/**",
        "**/.cache/**",
        "**/logs/**",
        "**/*.log",
        "**/tmp/**",
        "**/__pycache__/**",
        "**/node_modules/**",
        "/mnt/fast/backrest/cache/**"
      ],
      "schedule": {
        "cron": "0 3 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 7,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_SUCCESS"],
          "onError": "ON_ERROR_IGNORE",
          "actionWebhook": {
            "webhookUrl": "${DEADMAN_URL}",
            "method": "POST",
            "template": "ok"
          }
        },
        {
          "conditions": ["CONDITION_SNAPSHOT_ERROR"],
          "onError": "ON_ERROR_IGNORE",
          "actionWebhook": {
            "webhookUrl": "http://ntfy/backups?priority=high&tags=rotating_light",
            "method": "POST",
            "template": "Fast volume backup FAILED: {{ .Error }}"
          }
        }
      ]
    },
    {
      "id": "slow-volume-selective",
      "repo": "hetzner",
      "paths": [
        "/mnt/slow/books",
        "/mnt/slow/immich",
        "/mnt/slow/samba"
      ],
      "excludes": [
        "**/cache/**",
        "**/@eaDir/**",
        "**/pgdata/**"
      ],
      "schedule": {
        "cron": "0 4 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 7,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_ERROR"],
          "onError": "ON_ERROR_IGNORE",
          "actionWebhook": {
            "webhookUrl": "http://ntfy/backups?priority=high&tags=rotating_light",
            "method": "POST",
            "template": "Slow volume backup FAILED: {{ .Error }}"
          }
        }
      ]
    }
  ]
}
