{
  "instance": "services-vm",
  "version": 4,
  "auth": {
    "disabled": false,
    "users": [
      {
        "name": "admin",
        "passwordBcrypt": "${BACKREST_ADMIN_PASSWORD_BCRYPT}"
      }
    ]
  },
  "repos": [
    {
      "id": "hetzner",
      "uri": "sftp:storagebox:/home/restic",
      "password": "${RESTIC_PASSWORD}",
      "env": [],
      "flags": [],
      "autoUnlock": false,
      "autoInitialize": true,
      "commandPrefix": {
        "ioNice": "IO_BEST_EFFORT_LOW",
        "cpuNice": "CPU_LOW"
      },
      "prunePolicy": {
        "schedule": {
          "cron": "0 4 * * 0",
          "clock": "CLOCK_LOCAL"
        },
        "maxUnusedPercent": 25
      },
      "checkPolicy": {
        "schedule": {
          "cron": "0 5 1 * *",
          "clock": "CLOCK_LOCAL"
        },
        "readDataSubsetPercent": 5
      },
      "hooks": [
        {
          "conditions": [
            "CONDITION_ANY_ERROR"
          ],
          "onError": "ON_ERROR_IGNORE",
          "actionShoutrrr": {
            "shoutrrrUrl": "generic+http://ntfy/backups?title=Backrest+error&priority=high&tags=rotating_light",
            "template": "Repository error on {{ .Repo.Id }}: {{ .Error }}"
          }
        }
      ]
    }
  ],
  "plans": [
    {
      "id": "fast-volume",
      "repo": "hetzner",
      "paths": [
        "/mnt/fast"
      ],
      "excludes": [
        "**/docker/**",
        "**/pgdata/**",
        "**/postgresql/**",
        "**/cache/**",
        "**/Cache/**",
        "**/.cache/**",
        "**/logs/**",
        "**/*.log",
        "**/tmp/**",
        "**/__pycache__/**",
        "**/node_modules/**",
        "/mnt/fast/backrest/cache/**",
        "/mnt/fast/immich/model-cache/**",
        "/mnt/fast/kavita/config/cache-long/**",
        "/mnt/fast/kavita/config/temp/**",
        "/mnt/fast/frigate/config/model_cache/**",
        "/mnt/fast/homeassistant/tts/**",
        "/mnt/fast/bookstack/db/**",
        "/mnt/fast/karakeep/meili/**",
        "/mnt/fast/vaultwarden/icon_cache/**",
        "/mnt/fast/vaultwarden/tmp/**",
        "/mnt/fast/syncthing/config/index-v2/**"
      ],
      "schedule": {
        "cron": "0 3 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 7,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": [
            "CONDITION_SNAPSHOT_SUCCESS"
          ],
          "onError": "ON_ERROR_IGNORE",
          "actionHealthchecks": {
            "webhookUrl": "${DEADMAN_URL}",
            "template": "ok"
          }
        },
        {
          "conditions": [
            "CONDITION_SNAPSHOT_ERROR"
          ],
          "onError": "ON_ERROR_IGNORE",
          "actionShoutrrr": {
            "shoutrrrUrl": "generic+http://ntfy/backups?title=Backrest+error&priority=high&tags=rotating_light",
            "template": "Fast volume backup FAILED: {{ .Error }}"
          }
        }
      ]
    },
    {
      "id": "slow-volume-selective",
      "repo": "hetzner",
      "paths": [
        "/mnt/slow/books",
        "/mnt/slow/photos",
        "/mnt/slow/proton-mail-archive",
        "/mnt/slow/samba"
      ],
      "excludes": [
        "**/cache/**",
        "**/@eaDir/**",
        "**/pgdata/**",
        "/mnt/slow/photos/thumbs/**",
        "/mnt/slow/photos/encoded-video/**"
      ],
      "schedule": {
        "cron": "0 4 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 7,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": [
            "CONDITION_SNAPSHOT_ERROR"
          ],
          "onError": "ON_ERROR_IGNORE",
          "actionShoutrrr": {
            "shoutrrrUrl": "generic+http://ntfy/backups?title=Backrest+error&priority=high&tags=rotating_light",
            "template": "Slow volume backup FAILED: {{ .Error }}"
          }
        }
      ]
    }
  ]
}
