# Backrest secrets (services VM)
# Copy to .sops.env and encrypt with:
#   SOPS_AGE_KEY_FILE=../../sops_age_key.txt sops -e -i .sops.env
#
# These are substituted into config.json ONCE, on first start, by the
# config-init container. Backrest owns config.json afterwards.

# Restic repository password.
#
# CRITICAL: this is one of two things standing between you and permanent data
# loss (the other is the age key). It is stored here encrypted to the age key,
# which lives on the machines being backed up — so a copy of BOTH must exist
# offline, outside this infrastructure. See README.md "Offline recovery
# artifact". Do not put it only in Vaultwarden: Vaultwarden's own backup is
# encrypted with it.
# Generate: openssl rand -base64 48
RESTIC_PASSWORD=changeme_strong_restic_repository_password

# BASE64 of the bcrypt hash of the Backrest web UI admin password. Backrest
# base64-decodes passwordBcrypt before comparing (internal/auth/auth.go) — a
# raw bcrypt here can NEVER log in, which is exactly how the test harness
# caught the previous version of this instruction.
# Generate: htpasswd -bnBC 10 "" 'yourpassword' | tr -d ':\n' | base64 -w0
#
# (base64 output has no '$', so this particular value no longer needs the
# single-quoting treatment — but any OTHER value containing '$', like a
# password in RESTIC_PASSWORD, still MUST be single-quoted in the plaintext
# .env before encrypting: the decrypt-and-source path expands it otherwise.)
BACKREST_ADMIN_PASSWORD_BCRYPT=changeme_base64_of_bcrypt_hash

# Dead-man's switch endpoint, pinged on every successful fast-volume snapshot.
#
# This is the only check that catches "the timer silently stopped firing three
# weeks ago" — success notifications train you to ignore them, and failure
# notifications never arrive if nothing runs. Use a healthchecks.io check (free
# tier) or any service that alerts on ABSENCE of a ping.
DEADMAN_URL=https://hc-ping.com/changeme-uuid
