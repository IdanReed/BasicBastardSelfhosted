# Mounted at /etc/ssh/ssh_config (system-wide) inside the Backrest container
# — NOT /root/.ssh/config, which ssh refuses unless root-owned; Arcane's sync
# delivers files owned by PUID 1000.
# Referenced by the repo URI "sftp:storagebox:/home/restic".
#
# Replace uXXXXXX with the Hetzner Storage Box sub-account username. Use a
# SUB-ACCOUNT scoped to its own directory, not the main account — restic
# authenticates with full write access to whatever it can see, so a compromised
# or malfunctioning services VM can `forget --prune` the entire repository.
# Storage Box snapshots (enabled in the Hetzner console) are what makes that
# recoverable; see README.md.

Host storagebox
    HostName uXXXXXX.your-storagebox.de
    Port 23
    User uXXXXXX
    IdentityFile /root/.ssh/id_ed25519
    IdentitiesOnly yes
    # PINNED, not trust-on-first-use. `accept-new` (what this was until
    # 2026-08-31) plus a known_hosts in the container's WRITABLE LAYER meant a
    # fresh TOFU on every container recreate — an image bump, a compose edit,
    # an Arcane redeploy — and each of those first uses would accept whatever
    # answered, for a peer holding credentials that can `forget --prune` every
    # backup. `yes` also closes the accept-new hole where a MITM simply offers
    # a key TYPE the file has no entry for: all three of Hetzner's are listed.
    StrictHostKeyChecking yes
    # The pin itself, mounted read-only from ./known_hosts. GLOBAL rather than
    # the per-user file precisely because the per-user file is the ephemeral
    # one; /dev/null for the user file so nothing in the writable layer can
    # ever widen what is trusted, and UpdateHostKeys off so ssh does not try
    # to append rotated keys to it.
    GlobalKnownHostsFile /etc/ssh/ssh_known_hosts
    UserKnownHostsFile /dev/null
    UpdateHostKeys no
    ServerAliveInterval 30
