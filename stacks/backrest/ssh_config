# Mounted at /etc/ssh/ssh_config (system-wide) inside the Backrest container —
# NOT /root/.ssh/config, which ssh refuses unless root-owned, and the stack git
# sync delivers files owned by uid 1000. Referenced by the repo URI
# "sftp:storagebox:/home/restic".
#
# The User below must stay a Hetzner Storage Box SUB-ACCOUNT scoped to its own
# directory, never the main account: restic has full write access to whatever
# it can see, so a compromised services VM can `forget --prune` the whole
# repository. Storage Box snapshots are what make that recoverable — see
# README.md. config-init.sh refuses to seed while the username is still the
# committed placeholder.

Host storagebox
    HostName u662946.your-storagebox.de
    Port 23
    User u662946-sub1
    IdentityFile /root/.ssh/id_ed25519
    IdentitiesOnly yes
    # PINNED, not trust-on-first-use. `accept-new` plus a known_hosts in the
    # container's WRITABLE LAYER means a fresh TOFU on every recreate (image
    # bump, compose edit, redeploy), each accepting whatever answered — for a
    # peer holding credentials that can `forget --prune` every backup. `yes`
    # also closes the accept-new hole where a MITM offers a key TYPE the file
    # has no entry for: all three of Hetzner's are listed.
    StrictHostKeyChecking yes
    # The pin itself, mounted read-only from ./known_hosts. GLOBAL rather than
    # the per-user file precisely because the per-user file is the ephemeral
    # one; /dev/null for the user file so nothing in the writable layer can
    # ever widen what is trusted, and UpdateHostKeys off so ssh does not try
    # to append rotated keys to it.
    GlobalKnownHostsFile /etc/ssh/ssh_known_hosts
    UserKnownHostsFile /dev/null
    UpdateHostKeys no
    ServerAliveInterval 30
