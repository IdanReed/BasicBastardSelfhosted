# Immich stack secrets (services VM)
# Copy to .sops.env, fill, then `sops -e -i .sops.env` — encrypting a NEW
# file needs only the pubkey in .sops.yaml (no age key, no sudo);
# editing later goes through `sopsedit` (see CLAUDE.md).
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/immich.sops.env must all carry EXACTLY the same keys — the
# stack-env-drift lint fails on any difference.
#
# Reminder from CLAUDE.md: any value containing '$' must be single-quoted in
# the plaintext before encrypting — the decrypt-and-source path expands it
# otherwise. (None of the generate commands below emit '$'.)

# ---------------------------------------------------------------------------
# Postgres password, TWICE with the SAME value: immich-server reads
# DB_PASSWORD, the ghcr.io/immich-app/postgres image reads POSTGRES_PASSWORD,
# and both containers get this whole .env. If the two ever differ the server
# simply cannot authenticate to its own database.
# Generate once: openssl rand -hex 24
# ---------------------------------------------------------------------------
DB_PASSWORD=changeme_openssl_rand_hex_24
POSTGRES_PASSWORD=changeme_same_value_as_DB_PASSWORD

# ---------------------------------------------------------------------------
# OIDC client secret, rendered into immich.json by immich-config-init. The
# SAME value must live in headscale-vps/secrets.sops.yaml as
# IMMICH_OIDC_CLIENT_SECRET (the Authentik blueprint reads it via !Env) —
# rotating it means editing BOTH files, a VPS `nixos-rebuild switch`, and
# re-running this stack so config-init re-renders (it rewrites on content
# change, not touch-once). Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
IMMICH_OIDC_CLIENT_SECRET=changeme_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Local admin seeded headlessly by immich-init (works exactly once). Use the
# SAME email as your Authentik user: Immich links OIDC logins by email, so a
# match merges the OIDC identity into this admin on first login; a mismatch
# yields two separate users (annex §4/§8.4). The password is the
# password-login fallback when Authentik is unreachable.
# ---------------------------------------------------------------------------
# Single token on purpose — a space would need quoting to survive the
# decrypt-and-source path AND compose's env_file parsing; not worth it for a
# display name.
IMMICH_ADMIN_EMAIL=idan@idanreed.com
IMMICH_ADMIN_NAME=Idan
IMMICH_ADMIN_PASSWORD=changeme_strong_password
