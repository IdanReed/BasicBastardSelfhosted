# Immich — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/immich.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).

# Postgres
# Same value twice: immich-server reads DB_PASSWORD, the postgres image reads
# POSTGRES_PASSWORD, and both containers get this whole .env.
# openssl rand -hex 24
DB_PASSWORD=changeme_hex24
POSTGRES_PASSWORD=changeme_same_value_as_DB_PASSWORD

# OIDC
# Rendered into immich.json by immich-config-init. Twin of
# IMMICH_OIDC_CLIENT_SECRET in headscale-vps/secrets.sops.yaml — rotating means
# both files + a VPS nixos-rebuild + a re-up of this stack.
# openssl rand -hex 32
IMMICH_OIDC_CLIENT_SECRET=changeme_hex32

# Local admin
# Seeded once by immich-init. Use the SAME email as your Authentik user —
# Immich links OIDC logins by email and a mismatch yields two users. The
# password is the fallback when Authentik is unreachable. Single-token name.
# openssl rand -base64 24
IMMICH_ADMIN_EMAIL=idan@idanreed.com
IMMICH_ADMIN_NAME=Idan
IMMICH_ADMIN_PASSWORD=changeme_strong_password
