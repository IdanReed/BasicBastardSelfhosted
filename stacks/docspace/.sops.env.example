# DocSpace — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/docspace.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).

# Machine key
# NEVER ROTATE AND NEVER LEAVE EMPTY. It is core.machinekey: it derives the
# password salt and signs every confirm-scheme link. Empty makes upstream's
# ensure_secret generate one INTO A BIND MOUNT, invisible to sops, and a
# restore then locks every user out permanently. openssl rand -hex 16
APP_CORE_MACHINEKEY=changeme_hex32

# Identity encryption
# NEVER ROTATE — ASC.Identity's stored OAuth client secrets are encrypted with
# it. Same auto-generate-into-the-volume trap as above. openssl rand -hex 16
SPRING_APPLICATION_ENCRYPTION_SECRET=changeme_hex32

# Document Server JWT
# Same value in both keys. Not just auth: externalRequest.directIfIn.jwtToken
# defaults true, so turning JWT off breaks every download and callback in a
# private-address fleet. Rotating is disruptive, not destructive.
# openssl rand -hex 32
DOCUMENT_SERVER_JWT_SECRET=changeme_hex32
JWT_SECRET=changeme_same_value_as_DOCUMENT_SERVER_JWT_SECRET

# MySQL
# Both must change together. openssl rand -hex 24
MYSQL_PASSWORD=changeme_hex24
MYSQL_ROOT_PASSWORD=changeme_hex24

# Portal owner
# docspace_init drives PUT /api/2.0/settings/wizard/complete. Until it runs,
# anyone who can reach the port can complete the wizard and own the portal —
# the loopback-only publish and this container racing first are the guards.
# openssl rand -base64 24
DOCSPACE_ADMIN_EMAIL=idan@idanreed.com
DOCSPACE_ADMIN_PASSWORD=changeme_strong_password
