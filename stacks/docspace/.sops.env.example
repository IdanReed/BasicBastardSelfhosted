# OnlyOffice DocSpace stack secrets (services VM)
# Copy to .sops.env and encrypt with:
#   SOPS_AGE_KEY_FILE=../../sops_age_key.txt sops -e -i .sops.env
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/docspace.sops.env must all carry EXACTLY the same keys — the
# stack-env-drift lint fails on any difference.
#
# Every generate command below is `openssl rand -hex`, which cannot emit a '$'
# — so unlike Vaultwarden's ADMIN_TOKEN, nothing here needs single-quoting
# (finding #30). Keep it that way if you change them.
#
# ⚠ TWO OF THESE ARE DESTRUCTIVE TO ROTATE. Read both.

# ---------------------------------------------------------------------------
# 🚨 APP_CORE_MACHINEKEY — NEVER ROTATE, AND NEVER LEAVE IT EMPTY.
#
# It is `core.machinekey`. It DERIVES THE PASSWORD SALT when core:password:salt
# is unset (which it is), signs every confirm-scheme link (the setup wizard,
# invites, email changes, password resets), and is exported as
# SPRING_APPLICATION_SIGNATURE_SECRET for ASC.Identity. Change it and every
# stored password stops matching and every outstanding confirmation link dies.
#
# The empty case is the dangerous one and upstream's own compose sets it that
# way: `ensure_secret` takes the env var if non-empty, else reads
# /app/onlyoffice/data/.secrets/APP_CORE_MACHINEKEY, else GENERATES one and
# writes it there. That is a sane default upstream and a bad one here — the
# fleet's most consequential secret would exist only inside a bind mount,
# invisible to sops, and a restore from anything but a byte-exact copy would
# lock every user out permanently.
#
# The only distinction between the two paths in the log is one line reading
# "Using APP_CORE_MACHINEKEY from environment.", which scrolls past — so the
# suite asserts the value in play is the one from the fixture.
# Generate (32 chars): openssl rand -hex 16
# ---------------------------------------------------------------------------
APP_CORE_MACHINEKEY=changeme_openssl_rand_hex_16

# ---------------------------------------------------------------------------
# 🚨 SPRING_APPLICATION_ENCRYPTION_SECRET — NEVER ROTATE.
# ASC.Identity's stored OAuth client secrets are encrypted with it. Same
# auto-generate-into-the-volume behaviour as the machine key above.
# Generate (32 chars): openssl rand -hex 16
# ---------------------------------------------------------------------------
SPRING_APPLICATION_ENCRYPTION_SECRET=changeme_openssl_rand_hex_16

# ---------------------------------------------------------------------------
# The Document Server JWT.
#
# ⚠ It is NOT only authentication. `externalRequest.directIfIn.jwtToken`
# defaults true, so URLs carried inside a signed token bypass Document
# Server's private-IP filter — which means turning JWT OFF breaks every
# document download and callback in a private-address fleet. The usual "disable
# auth to debug" instinct makes things worse here, not better.
#
# The same value must reach BOTH containers: DOCUMENT_SERVER_JWT_SECRET on the
# monolith and JWT_SECRET on Document Server. Rotating it is disruptive (open
# editing sessions break) but not destructive.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
DOCUMENT_SERVER_JWT_SECRET=changeme_openssl_rand_hex_32
JWT_SECRET=changeme_same_value_as_DOCUMENT_SERVER_JWT_SECRET

# ---------------------------------------------------------------------------
# MySQL. Both values must change together if you rotate them.
# Generate each: openssl rand -hex 24
# ---------------------------------------------------------------------------
MYSQL_PASSWORD=changeme_openssl_rand_hex_24
MYSQL_ROOT_PASSWORD=changeme_openssl_rand_hex_24

# ---------------------------------------------------------------------------
# The portal owner, created by docspace_init through the wizard API.
#
# The wizard is a browser page, but behind it is
# `PUT /api/2.0/settings/wizard/complete` — and the two things that would
# normally make that unusable from a script (the wizard token and the PBKDF2
# parameters) are both handed out by the UNAUTHENTICATED GET /api/2.0/settings,
# because the wizard page itself needs them before any account exists.
#
# That is also what makes the init idempotent for free: the token exists only
# while the wizard is incomplete, so its absence means "already seeded".
#
# ⚠ Until this runs, ANYONE who can reach the port can complete the wizard and
# become the portal owner. The loopback-only publish and this container racing
# to be first are the guards — the same posture as rmfakecloud.
# Generate the password: openssl rand -base64 24
# ---------------------------------------------------------------------------
DOCSPACE_ADMIN_EMAIL=idan@idanreed.com
DOCSPACE_ADMIN_PASSWORD=changeme_strong_password
