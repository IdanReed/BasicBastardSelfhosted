# Tracking stack secrets (services VM) — bookstack, homebox, karakeep
# Copy to .sops.env and encrypt with:
#   SOPS_AGE_KEY_FILE=../../sops_age_key.txt sops -e -i .sops.env
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/tracking.sops.env must all carry EXACTLY the same keys — the
# stack-env-drift lint fails on any difference.
#
# Reminder from CLAUDE.md: any value containing '$' must be single-quoted in
# the plaintext before encrypting — the decrypt-and-source path expands it
# otherwise.
#
# ⚠ TWO OF THESE MUST NEVER BE ROTATED once the stack has data. They are
# marked below. Rotating them is not "log everyone out", it is data loss.

# ---------------------------------------------------------------------------
# BookStack
#
# APP_KEY: a MISSING value makes BookStack's init script `sleep infinity`
# rather than exit — the container reports "running" forever, restart policies
# never fire, and there is no crash to alert on. Only the /status healthcheck
# catches it.
#
# 🚨 AND IT MUST DECODE TO EXACTLY 32 BYTES. This is Laravel's AES-256-CBC key,
# so `base64:` + 32 raw bytes; a 33- or 37-byte value is NOT rejected at
# startup. BookStack boots, runs every migration, serves HTML, and accepts the
# admin hook — and then throws
#   RuntimeException: Unsupported cipher or incorrect key length
# on the FIRST encrypted operation, which happens during middleware
# termination, i.e. AFTER the response has been sent. Nothing in the container
# log says the key is wrong. /status is the only thing that surfaces it, which
# is exactly why the healthcheck probes /status rather than /.
#
# The generate command below produces a correct one; if you write the value by
# hand, check it: printf '%s' "<value after base64:>" | base64 -d | wc -c
# Generate: docker run --rm --entrypoint /bin/bash \
#             lscr.io/linuxserver/bookstack:version-v26.05.4 appkey
#   (produces a `base64:...` string)
#
# The admin credentials are applied from INSIDE the container by
# bookstack-admin-init.sh, which replaces the seeded admin@admin.com /
# password account. Leave them at the changeme_ placeholder and that seeded
# account stays live — the script refuses to set a placeholder password.
# ---------------------------------------------------------------------------
APP_KEY=changeme_base64_app_key
BOOKSTACK_ADMIN_EMAIL=idan@idanreed.com
BOOKSTACK_ADMIN_NAME=Idan
BOOKSTACK_ADMIN_PASSWORD=changeme_strong_password

# ---------------------------------------------------------------------------
# BookStack's MariaDB. MYSQL_ROOT_PASSWORD keeps that exact spelling (not
# MARIADB_) because nixos/backup-prepare.sh reads it from the container's own
# environment to run mysqldump.
# Generate each: openssl rand -hex 24
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=changeme_openssl_rand_hex_24
MARIADB_PASSWORD=changeme_openssl_rand_hex_24
DB_PASSWORD=changeme_same_value_as_MARIADB_PASSWORD

# ---------------------------------------------------------------------------
# Homebox
#
# ⚠ HBOX_AUTH_API_KEY_PEPPER IS REQUIRED AT STARTUP — the app refuses to boot
# if it is shorter than 32 bytes. It is absent from essentially every compose
# example online, so a config copied from a blog post produces a container
# that will not start and gives no obvious reason why.
#
# ⚠ NEVER ROTATE IT: doing so invalidates every API key ever issued.
# Generate: openssl rand -base64 48
# ---------------------------------------------------------------------------
HBOX_AUTH_API_KEY_PEPPER=changeme_openssl_rand_base64_48
HOMEBOX_ADMIN_EMAIL=idan@idanreed.com
HOMEBOX_ADMIN_NAME=Idan
HOMEBOX_ADMIN_PASSWORD=changeme_strong_password

# ---------------------------------------------------------------------------
# Karakeep
#
# ⚠ NEVER ROTATE NEXTAUTH_SECRET once there are sessions: it signs both
# sessions and asset URLs.
# Generate: openssl rand -base64 36
#
# MEILI_MASTER_KEY is read by BOTH karakeep and the meilisearch container —
# meilisearch refuses to start in production mode without one at least 16
# bytes long, and karakeep uses the same value to talk to it.
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=changeme_openssl_rand_base64_36
MEILI_MASTER_KEY=changeme_openssl_rand_base64_32
KARAKEEP_ADMIN_EMAIL=idan@idanreed.com
KARAKEEP_ADMIN_NAME=Idan
KARAKEEP_ADMIN_PASSWORD=changeme_strong_password

# ---------------------------------------------------------------------------
# OIDC client secrets — LEAVE EMPTY until the Authentik side exists.
#
# Empty is a complete state for all three, not a placeholder:
#   - bookstack keeps AUTH_METHOD=standard (set in compose)
#   - homebox keeps HBOX_OIDC_ENABLED=false — and note that turning it ON
#     makes the container depend on Authentik being reachable AT STARTUP,
#     with only ~7.5s of retry
#   - karakeep enables its provider purely by the PRESENCE of
#     OAUTH_WELLKNOWN_URL, so an unset value is the off switch
#
# ⚠ For Karakeep, bootstrap BEFORE locking down: DISABLE_PASSWORD_AUTH=true
# disables both user creation and the api-key exchange that tracking-init
# uses to verify credentials.
# Generate each: openssl rand -hex 32
# ---------------------------------------------------------------------------
BOOKSTACK_OIDC_CLIENT_SECRET=
HOMEBOX_OIDC_CLIENT_SECRET=
KARAKEEP_OIDC_CLIENT_SECRET=
