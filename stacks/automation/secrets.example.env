# Automation — the keys stored in secrets.sops.json, one value each (`sopsgen
# apply` fills generated ones, `sopsedit` the rest). Values built from other
# secrets live in env.nix. Key set must match secrets.sops.json and
# tests/fixtures/stacks/automation.sops.json.

# Home Assistant
# Owner account, created once by automation-init (POST /api/onboarding/users).
# HA_ADMIN_NAME is a display name — keep it a single token (no quoting needed).
HA_ADMIN_NAME=Idan
HA_ADMIN_USER=idan
# openssl rand -base64 24
HA_ADMIN_PASSWORD=changeme_strong_password

# MQTT
# mosquitto-init re-hashes all three into the broker's password file at every
# start. FRIGATE_MQTT_PASSWORD keeps that prefix: Frigate substitutes only
# FRIGATE_-prefixed variables into frigate.yaml, silently. openssl rand -hex 24
FRIGATE_MQTT_PASSWORD=changeme_hex24
MQTT_HA_PASSWORD=changeme_hex24
MQTT_HEALTHCHECK_PASSWORD=changeme_hex24

# Frigate cameras
# One login shared by both Reolinks, substituted into frigate.yaml's go2rtc
# stream URLs as {FRIGATE_REOLINK_USER} / {FRIGATE_REOLINK_PASSWORD} (Frigate
# reads only FRIGATE_-prefixed variables, silently). It lands in a URL query
# string: letters and digits only. A stream whose variable is unset is dropped.
FRIGATE_REOLINK_USER=admin
FRIGATE_REOLINK_PASSWORD=changeme_camera_password
