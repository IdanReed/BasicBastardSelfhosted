# Automation — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/automation.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).

# Home Assistant
# Owner account, created once by automation-init (POST /api/onboarding/users).
# HA_ADMIN_NAME is a display name — keep it a single token (no quoting needed).
HA_ADMIN_NAME=Idan
HA_ADMIN_USER=idan
# openssl rand -base64 24
HA_ADMIN_PASSWORD=changeme_strong_password

# MQTT
# mosquitto-init re-hashes all three into the broker's password file at every
# start. FRIGATE_MQTT_PASSWORD keeps that prefix: Frigate substitutes only
# FRIGATE_-prefixed variables into frigate.yaml, silently. openssl rand -hex 24
FRIGATE_MQTT_PASSWORD=changeme_hex24
MQTT_HA_PASSWORD=changeme_hex24
MQTT_HEALTHCHECK_PASSWORD=changeme_hex24

# Frigate cameras
# EMPTY is the shipping state (`cameras: {}` is valid). Add a camera as a
# FRIGATE_CAM_<NAME> key holding its full RTSP URL, referenced from
# frigate.yaml as "{FRIGATE_CAM_<NAME>}"; a literal { or } in the URL puts
# Frigate into SAFE MODE looking healthy. Add new keys to all three files.
FRIGATE_CAM_EXAMPLE=
