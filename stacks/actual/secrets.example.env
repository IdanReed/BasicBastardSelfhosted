# Actual Budget — the keys stored in secrets.sops.json, one value each (`sopsgen
# apply` fills generated ones, `sopsedit` the rest). Values built from other
# secrets live in env.nix. Key set must match secrets.sops.json and
# tests/fixtures/stacks/actual.sops.json.

# Server password
# actual_init POSTs it to /account/bootstrap on the first run; from then on the
# database holds the password and changes belong in the client UI. The init
# logs in with this value again only when it must enable or re-apply OpenID, so
# a stale value fails that one step loudly and nothing else. It is also what the
# first OpenID login asks for before it makes that user the owner.
# openssl rand -base64 24
ACTUAL_INIT_PASSWORD=changeme_strong_password

# OIDC
# Never read: compose.yaml sets ACTUAL_OPENID_CLIENT_ID=actual on actual_init,
# and environment wins over the env file. The client secret is
# ACTUAL_OPENID_CLIENT_SECRET in secrets/shared.sops.json, through env.nix.
# Dropping this key means dropping it here, in secrets.sops.json and in the
# fixture together (stack-env-drift).
ACTUAL_OPENID_CLIENT_ID=changeme_authentik_client_id
