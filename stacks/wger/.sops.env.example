# Wger — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/wger.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).
# BARE Django names on purpose — see stacks/tandoor/.sops.env.example.

# Django
# UNSET IS NEARLY INVISIBLE: settings/main.py generates a NEW key on EVERY
# RESTART with only a warnings.warn, so the symptom is "everyone is logged out
# after every restart", diagnosed weeks later. openssl rand -hex 32
SECRET_KEY=changeme_hex32

# Postgres
# Two names, one value: POSTGRES_PASSWORD initialises the role,
# DJANGO_DB_PASSWORD is what Django connects with. openssl rand -hex 24
POSTGRES_PASSWORD=changeme_hex24
DJANGO_DB_PASSWORD=changeme_same_value_as_POSTGRES_PASSWORD

# Admin
# The account already exists and you did not choose its password: `wger
# bootstrap` loads a fixture pinning username `admin` to the literal
# `adminadmin`, is_staff but NOT superuser, with no env var anywhere to change
# it. wger_init sets the password from this value and promotes the account.
# The reset re-arms on a wiped pgdata, not on a truncated users table.
# openssl rand -base64 24
WGER_ADMIN_PASSWORD=changeme_strong_password
