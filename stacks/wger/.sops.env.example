# Wger stack secrets (services VM)
# Copy to .sops.env and encrypt with:
#   SOPS_AGE_KEY_FILE=../../sops_age_key.txt sops -e -i .sops.env
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/wger.sops.env must all carry EXACTLY the same keys — the
# stack-env-drift lint fails on any difference.
#
# ⚠ These are BARE Django names on purpose, which is why Wger and Tandoor are
# separate stacks — see stacks/tandoor/.sops.env.example.

# ---------------------------------------------------------------------------
# 🚨 SECRET_KEY unset is NEARLY INVISIBLE, and worse than Tandoor's version of
# the same trap. settings/main.py does `SECRET_KEY = env.str('SECRET_KEY', '')`
# and then, if it is empty or matches a known published default,
# `SECRET_KEY = secrets.token_urlsafe(50)` with a `warnings.warn` and nothing
# else — so a NEW key is generated on EVERY RESTART. The symptom is "everyone
# is logged out after every restart", diagnosed weeks later.
#
# Note upstream's published default in prod.env contains '$' characters. If you
# ever paste it anywhere, single-quote it (finding #30).
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
SECRET_KEY=changeme_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Postgres. Two names, one value: POSTGRES_PASSWORD initialises the role in the
# database container, DJANGO_DB_PASSWORD is what Django connects with.
# Generate: openssl rand -hex 24
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme_openssl_rand_hex_24
DJANGO_DB_PASSWORD=changeme_same_value_as_POSTGRES_PASSWORD

# ---------------------------------------------------------------------------
# 🚨 THE ADMIN ACCOUNT ALREADY EXISTS AND YOU DID NOT CHOOSE ITS PASSWORD.
#
# The entrypoint runs `wger bootstrap`, which on a fresh database calls
# `create_or_reset_admin` — a `loaddata` of a fixture pinning username `admin`,
# is_staff true, is_superuser FALSE, and the literal pbkdf2 hash for
# **`adminadmin`**. Its own log line says:
#     *** Password for user admin was reset to 'adminadmin'
# There is no env var for it anywhere — not DJANGO_SUPERUSER_*, not anything.
# `load_fixtures` also loads the same users.json, so blocking one would achieve
# nothing.
#
# wger_init sets the password from the value below and promotes the account to
# superuser, because the fixture leaves it is_staff-but-not-superuser — which
# matters the moment you try to configure anything through /django-admin/.
#
# The gate is `database_exists()`, which asks "does the schema exist", not "are
# there users": truncating the users table does NOT re-arm the reset, but a
# wiped pgdata volume does.
# Generate: openssl rand -base64 24
# ---------------------------------------------------------------------------
WGER_ADMIN_PASSWORD=changeme_strong_password
