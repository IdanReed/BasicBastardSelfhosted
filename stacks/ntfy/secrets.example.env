# Ntfy — the keys stored in secrets.sops.json, one value each (`sopsgen
# apply` fills generated ones, `sopsedit` the rest). Values built from other
# secrets live in env.nix. Key set must match secrets.sops.json and
# tests/fixtures/stacks/ntfy.sops.json.
# Ntfy reads every config key from an NTFY_<KEY> env var, so these names are
# load-bearing — server.yml never references them.

# SMTP
# Proton Mail submission for alerts@idanreed.com. Leaving
# the VALUES empty is supported (phone push only); the KEYS must stay.
NTFY_SMTP_SENDER_ADDR=smtp.protonmail.ch:587
NTFY_SMTP_SENDER_USER=alerts@idanreed.com
NTFY_SMTP_SENDER_PASS=changeme_proton_smtp_token
