// Grafana Alloy — the fleet's only log collector.
//
// `loki.source.journal` and `loki.write` are Alloy's names for the loki PUSH
// PROTOCOL, not for the store: the store is VictoriaLogs, which ingests that
// protocol natively at /insert/loki/api/v1/push.
//
// 🚨 IT READS THE HOST JOURNAL AND MUST NEVER GET THE DOCKER SOCKET — not
// directly, not through a proxy. `discovery.docker`/`loki.source.docker`
// would be the obvious way to collect container logs and both need the
// root-equivalent socket in a networked container. Docker's journald log
// driver gets the same lines through two read-only bind mounts instead.
//
// 🚨 THE SILENT-ZERO FAILURE: without `path`, loki.source.journal filters on
// the reader's OWN /etc/machine-id, which inside a container matches no
// directory under /var/log/journal — a healthy, correctly-parsed Alloy
// forwarding ZERO entries forever, with no error. Measured against v1.19.2,
// EITHER `path` or the /etc/machine-id mount is sufficient and only losing
// both fails, so both are configured: `path` is self-documenting and survives
// a machine-id change (a Proxmox re-image), the mount survives someone
// "simplifying" `path` away.
//
// /run/log/journal is deliberately NOT mounted: with Storage=persistent it is
// used only before /var mounts, and mounting it makes docker create an empty
// /run/log/journal on the host that journald's flush logic then looks at.

// ---------------------------------------------------------------------------
// Source: the host journal
// ---------------------------------------------------------------------------
loki.source.journal "host" {
	path          = "/var/log/journal"
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.process.json_host.receiver]

	// How far back to read on a cold start; longer means a fresh Alloy
	// replays days of history into the store on first deploy.
	max_age = "12h"

	// 🚨 NO `labels` ARGUMENT. `labels = { job = "systemd-journal" }` does
	// NOT work when relabel_rules are also set — the component's own
	// default wins and every stream lands as
	// job="loki.source.journal.host", with no error, so
	// {job="systemd-journal"} (what the panels, the suite and the gatus
	// probe all query) comes back empty from a working pipeline. The
	// `job` label is set by a relabel rule below, which runs last.
}

// ---------------------------------------------------------------------------
// Relabelling: which journal fields become labels on the pushed streams
// ---------------------------------------------------------------------------
// 🚨 EVERY LABEL HERE IS A CARDINALITY DECISION, in two stages: a label
// promoted here rides the push protocol, and the sink's `_stream_fields`
// then decides which of them define a VictoriaLogs STREAM (one per
// unique value combination). An unbounded label that reaches
// `_stream_fields` is the standard way to make a log store unqueryable.
// Labels promoted but not listed there — only `level` today — are plain
// per-entry fields: filterable, not stream-defining.
//
// Deliberately NOT promoted: __journal__pid, __journal_container_id
// (changes on every `docker compose up`), and the message itself.
loki.relabel "journal" {
	forward_to = []

	// The stream name everything queries by. See the note on the source
	// block: this rule, not the `labels` argument, is what actually sets it.
	// A rule with no source_labels writes `replacement` verbatim.
	rule {
		target_label = "job"
		replacement  = "systemd-journal"
	}

	// Always `docker.service` for container output — dockerd submits every
	// line. `container` below is what distinguishes them.
	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	// Depends on the daemon's log-opts tag={{.Name}}: with no tag docker
	// puts the truncated container ID here and this becomes a cardinality
	// bomb that changes on every redeploy. The two settings are one
	// decision.
	rule {
		source_labels = ["__journal_container_name"]
		target_label  = "container"
	}

	// Syslog priority as a word. Deliberately NOT in `_stream_fields`: it
	// is per-entry, not a log source, and VictoriaLogs colours `level`.
	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}

	// One value today; stays correct if a second collector is added.
	rule {
		source_labels = ["__journal__hostname"]
		target_label  = "host"
	}
}

// ---------------------------------------------------------------------------
// Rename a top-level JSON "host" key before it reaches VictoriaLogs
// ---------------------------------------------------------------------------
// 🚨 VictoriaLogs parses a JSON log line into fields, so a line carrying its
// own top-level "host" key (Authentik's request logs: host="windmill.svc...")
// adds a SECOND `host` next to the label above. With `host` in
// `_stream_fields` that is a duplicate stream tag, and VictoriaLogs panics on
// it (FATAL: cannot unmarshal StreamTags ... "host" less or equal than
// "host") instead of rejecting the push — a crash loop for the whole store.
// The line's own key becomes http_host; the label stays the only `host`.
// Mirrored in headscale-vps/modules/log-shipper.nix.
loki.process "json_host" {
	forward_to = [loki.write.default.receiver]

	stage.replace {
		expression = "\"(host)\"\\s*:"
		replace    = "http_host"
	}
}

// ---------------------------------------------------------------------------
// Sink: VictoriaLogs, over the compose network
// ---------------------------------------------------------------------------
// The compose service name on the stack's own bridge network. NOT
// 127.0.0.1:10456 — a bridged container cannot reach a loopback-bound
// host publish — and not a Caddy vhost, whose forward-auth 302 would
// silently swallow every push.
loki.write "default" {
	endpoint {
		// 🚨 `_stream_fields` IS LOAD-BEARING. Left off, VictoriaLogs streams
		// on ALL pushed labels — fine today, but then a future relabel rule
		// promoting an unbounded field silently becomes a cardinality bomb.
		// Pinning it makes stream membership a two-file decision.
		url = "http://victorialogs:9428/insert/loki/api/v1/push?_stream_fields=job,unit,container,host"

		// A 429 from the sink is backpressure, not a reason to drop the
		// lines: delayed incident logs beat missing ones.
		retry_on_http_429 = true
	}

	// The WAL is what makes a store restart cost latency rather than data:
	// entries are durable here until acknowledged. Backed by /mnt/fast/alloy.
	wal {
		enabled = true
	}
}

// ---------------------------------------------------------------------------
// Alloy's own diagnostics
// ---------------------------------------------------------------------------
// Alloy logs to stdout, which the journald driver returns to the journal
// that loki.source.journal reads — so its own logs need no self-scrape.
logging {
	level  = "info"
	format = "logfmt"
}
