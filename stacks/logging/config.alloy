// Grafana Alloy — the fleet's only log collector.
//
// 🚨 IT READS THE HOST JOURNAL. IT DOES NOT GET THE DOCKER SOCKET, AND IT MUST
// NEVER GET ONE — not directly and not through a socket proxy. Alloy has
// `discovery.docker` and `loki.source.docker` components that would be the
// obvious way to collect container logs, and using either means mounting
// /var/run/docker.sock into a container that also talks to the network. That
// socket is root-equivalent on this host (it is exactly why Arcane's UI is
// loopback-only and behind Caddy). Routing container stdout through journald
// instead — virtualisation.docker.daemon.settings.log-driver in
// nixos/configuration.nix — gets the same lines with two read-only bind
// mounts and no privilege at all.
//
// 🚨 THE SILENT-ZERO FAILURE, AND WHAT ACTUALLY CAUSES IT. Without `path`,
// loki.source.journal opens the journal in local-machine mode, which filters
// on the reader's OWN /etc/machine-id — and inside a container that is a
// freshly generated id that matches no directory under /var/log/journal. The
// result is not an error. It is a running, HEALTHY, correctly-parsed Alloy
// that forwards ZERO entries forever.
//
// The received wisdom is "path is mandatory". Measured against v1.19.2 with
// /var/log/journal mounted in every case, that is half right — it is the
// COMBINATION that fails, and either half alone is sufficient:
//
//   path set   /etc/machine-id mounted   journal lines read in 18 s
//   --------   -----------------------   --------------------------
//   yes        yes                       4495
//   yes        no                        4560
//   no         yes                       4618
//   no         no                        0        <- healthy, silent
//
// BOTH are configured here anyway, and deliberately: the failure mode is
// invisible, so two independent reasons for the reader to find the journal is
// worth one read-only single-file mount. `path` is the self-documenting half
// and survives a host whose machine-id changes (a Proxmox re-image does
// exactly that — see the beszel-agent fingerprint note in
// nixos/generate-stack-dirs.py); the machine-id mount is the half that keeps
// working if someone "simplifies" `path` away.
//
// The bind mounts this file depends on (see compose.yaml, both :ro):
//   /var/log/journal   the persistent journal. services.journald.storage is
//                      pinned to "persistent" on the host precisely so this
//                      is where the entries are.
//   /etc/machine-id    the host's id, per the matrix above.
//
// /run/log/journal is deliberately NOT mounted, and the research that
// proposed three mounts included it: with Storage=persistent it is only used
// before /var is mounted and journald removes it after the flush, so mounting
// it is either a no-op or — worse — makes docker CREATE an empty
// /run/log/journal on the host, a directory journald's flush logic looks at.
// Nothing is gained and something is risked.

// ---------------------------------------------------------------------------
// Source: the host journal
// ---------------------------------------------------------------------------
loki.source.journal "host" {
	path          = "/var/log/journal"
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.write.default.receiver]

	// How far back to read on a cold start (no positions file yet). Matches
	// the order of magnitude of the host's journal buffer; longer would mean
	// a fresh Alloy replays days of history into Loki on first deploy.
	max_age = "12h"

	// 🚨 NO `labels` ARGUMENT, AND THAT IS A CORRECTION, NOT AN OMISSION.
	// `labels = { job = "systemd-journal" }` is the obvious way to write this
	// and it DOES NOT WORK when relabel_rules are also set: the component's
	// own default job label wins, and every stream lands with
	// job="loki.source.journal.host" instead. Measured against v1.19.2 — the
	// entries arrive, nothing errors, and Loki's /api/v1/label/job/values
	// answers with the component id. So anyone querying {job="systemd-journal"}
	// — the name in every Loki tutorial, and the one this fleet's Grafana
	// panels and gatus comments use — gets an empty result from a pipeline
	// that is working perfectly. This cost a debugging round before it was
	// caught, and the only reason it was caught is that the check was "did
	// this specific line arrive", not "is the container healthy".
	//
	// The `job` label is therefore set by a relabel rule below, which runs
	// last and wins. Verified after the change: a marker line written by a
	// container reached {job="systemd-journal"} in 2 s.
}

// ---------------------------------------------------------------------------
// Relabelling: which journal fields become Loki STREAM LABELS
// ---------------------------------------------------------------------------
// 🚨 EVERY LABEL HERE MULTIPLIES THE INDEX. Loki indexes labels and only
// labels; a label with unbounded values (a container ID, a PID, a request id)
// creates a stream per value and is the standard way to make a Loki install
// unqueryable. Everything below is bounded by the number of things running on
// one host. limits_config.max_streams_per_user in loki.yaml is the backstop.
//
// Note what is NOT promoted: __journal__pid, __journal_container_id (changes
// on every `docker compose up`), and the message itself.
loki.relabel "journal" {
	forward_to = []

	// The stream name everything queries by. See the note on the source
	// block: this rule, not the `labels` argument, is what actually sets it.
	// A rule with no source_labels writes `replacement` verbatim.
	rule {
		target_label = "job"
		replacement  = "systemd-journal"
	}

	// The systemd unit. For container output this is always `docker.service`
	// — docker's journald driver submits from dockerd, so every container
	// line shares that unit. `container` below is what distinguishes them.
	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	// The container name. This exists because the docker daemon is configured
	// with log-opts tag={{.Name}}; with no tag docker would put the truncated
	// container ID here instead and this label would be a cardinality bomb
	// that changes on every redeploy. The two settings are one decision.
	rule {
		source_labels = ["__journal_container_name"]
		target_label  = "container"
	}

	// Syslog priority as a word (err, warning, info, ...). Bounded to eight
	// values and it is what every "show me the errors" query filters on.
	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}

	// The host. One value today; it stays correct if a second collector is
	// ever pointed at this Loki.
	rule {
		source_labels = ["__journal__hostname"]
		target_label  = "host"
	}
}

// ---------------------------------------------------------------------------
// Sink: Loki, over the compose network
// ---------------------------------------------------------------------------
// `loki` is the compose service name, resolved on the stack's own bridge
// network. NOT 127.0.0.1:10456 — a bridged container cannot reach a
// loopback-bound host publish (the same constraint that forces gatus onto the
// host network), and NOT the Caddy vhost, because there is no vhost for Loki
// and a forward-auth 302 would silently swallow every push.
loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"

		// Explicit, not defaulted. A 429 from Loki means the ingestion rate
		// limit in loki.yaml bit — which is a burst to ride out, not a
		// reason to throw the lines away. Retrying is the difference between
		// "the incident's logs are delayed" and "the incident's logs are
		// gone", which is the only moment this stack is worth anything.
		retry_on_http_429 = true
	}

	// The write-ahead log. This — not the retry setting above — is what makes
	// a Loki restart cost latency rather than data: entries are durable here
	// until they are acknowledged. Backed by /mnt/fast/alloy; see
	// nixos/generate-stack-dirs.py for why that directory is root-owned (this
	// image sets no USER and runs as uid 0).
	wal {
		enabled = true
	}
}

// ---------------------------------------------------------------------------
// Alloy's own diagnostics
// ---------------------------------------------------------------------------
// Alloy logs to stdout, which the journald driver puts back into the journal,
// which loki.source.journal above then reads — so Alloy's own logs reach Loki
// by the same path as everything else. No self-scrape component is needed and
// none is configured.
logging {
	level  = "info"
	format = "logfmt"
}
