# Samba — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/samba.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file)
# — SMB passwords are a likely place to hit this.

# Interfaces
# Which interfaces smbd binds; emits both `interfaces` and `bind interfaces
# only`, which is why config.yml sets neither. `lo` is MANDATORY (the
# healthcheck dials \\localhost, so without it the container is permanently
# unhealthy while every real client works). Find the NIC with `ip -br link`.
#   SAMBA_INTERFACES=lo tailscale0 ens18
SAMBA_INTERFACES=changeme_lo_plus_tailscale0_plus_the_real_nic

# idan
# Empty or unset is the worst shape here: envsubst yields "", smbpasswd fails,
# the user never enters the passdb, and `map to guest = bad user` treats it as
# a GUEST while the container reports healthy — samba-init refuses to start on
# it. The username MIRRORS the Authentik one; that mirroring is the whole
# offboarding story. openssl rand -base64 24
SAMBA_IDAN_PASSWORD=changeme_memorable_passphrase

# Users
# copy_only twins of each VPS-side <USER>_INITIAL_PASSWORD (secrets-gen
# manifest user/*): hand-set the VPS value, `sopsgen apply` copies it here.
# samba-init refuses to start on any empty or changeme_ value.
SAMBA_ALONDRA_PASSWORD=changeme_memorable_passphrase
SAMBA_CALE_PASSWORD=changeme_memorable_passphrase
SAMBA_ZACH_PASSWORD=changeme_memorable_passphrase
SAMBA_RYLAN_PASSWORD=changeme_memorable_passphrase
SAMBA_CAMERON_PASSWORD=changeme_memorable_passphrase
SAMBA_JUSTIN_PASSWORD=changeme_memorable_passphrase
