# Books — the keys stored in secrets.sops.json, one value each (`sopsgen
# apply` fills generated ones, `sopsedit` the rest). Values built from other
# secrets live in env.nix. Key set must match secrets.sops.json and
# tests/fixtures/stacks/books.sops.json.

# Kavita
# Pre-seeded into appsettings.json; without it Kavita signs JWTs with the
# placeholder key that ships in the public repo, silently. Length is
# load-bearing (HMAC-SHA512, >= 512 bits) — use 128 chars, not 64.
# openssl rand -hex 64
KAVITA_TOKEN_KEY=changeme_hex64
# Local admin, seeded once by books-init; also what the shelfmark
# post-download hook logs in with. openssl rand -base64 24
KAVITA_ADMIN_USER=idan
KAVITA_ADMIN_PASSWORD=changeme_strong_password

# Audiobookshelf
# Root user (POST /init). Use the SAME email as your Authentik user — ABS links
# OIDC identities by email and a mismatch leaves you with two accounts. An
# EMPTY password would create a passwordless root; books-init refuses.
ABS_ADMIN_USER=idan
ABS_ADMIN_PASSWORD=changeme_strong_password
# ABS reads this EXACT name. Without it the secret lives in the database, so a
# /config restore invalidates every session. openssl rand -hex 32
JWT_SECRET_KEY=changeme_hex32

# Anna's Archive
# AA_MIRROR_URLS is REQUIRED for shelfmark's direct-download source to work at
# all (comma separated, no trailing slash); AA_DONATOR_KEY only buys the fast
# endpoints. Both empty = UI works, that source does not.
AA_MIRROR_URLS=
AA_DONATOR_KEY=
