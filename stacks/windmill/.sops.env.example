# Windmill — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/windmill.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).
# No OIDC key here on purpose: the OSS build has no OIDC login path, so SSO is
# Caddy forward auth only (stacks/caddy/Caddyfile).

# Postgres
# Two keys, one password: Windmill takes a full URL, the postgres container
# takes the password alone. DATABASE_URL is spelled out rather than assembled
# with ${...} in compose, which would render an empty password on a deploy that
# races the decrypt (finding #11). The user is `windmill`, not upstream's
# `postgres`, so backup-prepare.sh's `pg_dumpall -U windmill` works — change
# one and you change all three. openssl rand -hex 24
POSTGRES_PASSWORD=changeme_hex24
DATABASE_URL=postgres://windmill:changeme_hex24@windmill_db:5432/windmill?sslmode=disable

# Superadmin bearer
# THIS IS WHAT KEEPS admin@windmill.dev / changeme FROM BEING LIVE: windmill_init
# presents it, creates the real users, then DELETEs the default account. Rotates
# freely (a bearer token, not a KDF input). openssl rand -hex 32
SUPERADMIN_SECRET=changeme_hex32

# Workspace
# VESTIGIAL: windmill-init hardcodes the roster emails and reads the
# <USER>_INITIAL_PASSWORD values below, so nothing consumes WINDMILL_ADMIN_*.
# They stay only for key-set parity; drop all three together across the real
# file, this example and the fixture if you want them gone.
WINDMILL_ADMIN_EMAIL=idan@idanreed.com
WINDMILL_ADMIN_PASSWORD=changeme_strong_password
WINDMILL_WORKSPACE=main

# Users
# copy_only twins of each VPS-side <USER>_INITIAL_PASSWORD (secrets-gen
# manifest user/*): hand-set the VPS value, `sopsgen apply` copies it here.
# windmill-init creates idan as super_admin and the other six as regular users.
IDAN_INITIAL_PASSWORD=changeme_memorable_passphrase
ALONDRA_INITIAL_PASSWORD=changeme_memorable_passphrase
CALE_INITIAL_PASSWORD=changeme_memorable_passphrase
ZACH_INITIAL_PASSWORD=changeme_memorable_passphrase
RYLAN_INITIAL_PASSWORD=changeme_memorable_passphrase
CAMERON_INITIAL_PASSWORD=changeme_memorable_passphrase
JUSTIN_INITIAL_PASSWORD=changeme_memorable_passphrase
