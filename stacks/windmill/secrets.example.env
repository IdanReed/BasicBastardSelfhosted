# Windmill — the keys stored in secrets.sops.json, one value each (`sopsgen
# apply` fills generated ones, `sopsedit` the rest). Values built from other
# secrets live in env.nix. Key set must match secrets.sops.json and
# tests/fixtures/stacks/windmill.sops.json.
# No OIDC key here on purpose: the OSS build has no OIDC login path, so SSO is
# Caddy forward auth only (stacks/caddy/Caddyfile).

# Postgres
# The postgres container takes the password alone; env.nix builds Windmill's
# DATABASE_URL around it. The user is `windmill`, not upstream's `postgres`, so
# backup-prepare.sh's `pg_dumpall -U windmill` works — change one and you
# change both. openssl rand -hex 24
POSTGRES_PASSWORD=changeme_hex24

# Superadmin bearer
# THIS IS WHAT KEEPS admin@windmill.dev / changeme FROM BEING LIVE: windmill_init
# presents it, creates the real users, then DELETEs the default account. Rotates
# freely (a bearer token, not a KDF input). openssl rand -hex 32
SUPERADMIN_SECRET=changeme_hex32

# Workspace
# VESTIGIAL: windmill-init hardcodes the roster emails and reads the
# <USER>_INITIAL_PASSWORD values below, so nothing consumes WINDMILL_ADMIN_*.
# They stay only for key-set parity; drop all three together across the real
# file, this example and the fixture if you want them gone.
WINDMILL_ADMIN_EMAIL=idan@idanreed.com
WINDMILL_ADMIN_PASSWORD=changeme_strong_password
WINDMILL_WORKSPACE=main

