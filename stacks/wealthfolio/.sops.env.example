# Wealthfolio — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/wealthfolio.sops.env.
# A value containing '$' MUST be single-quoted — WF_AUTH_PASSWORD_HASH is made
# of them (compose interpolates env_file).

# Master key
# Derives BOTH the JWT signing key and the encryption key for
# /mnt/fast/wealthfolio/secrets.json (provider API keys). Rotating is not a
# re-login: secrets.json becomes permanently undecryptable. Must decode to
# exactly 32 bytes or the server refuses to boot. openssl rand -base64 32
WF_SECRET_KEY=changeme_base64_32

# Login
# Argon2id PHC — the only account on the instance; rotating it IS the password
# change. SINGLE-QUOTE IT: unquoted, the hash reaches the container as a
# different string and the server aborts at startup naming its own fix.
#   printf '%s' 'your-password' | nix shell nixpkgs#libargon2 -c \
#     argon2 "$(openssl rand -hex 8)" -id -t 3 -m 16 -p 4 -e
WF_AUTH_PASSWORD_HASH='changeme_argon2id_phc_keep_the_single_quotes'

# OIDC
# Twin of WEALTHFOLIO_OIDC_CLIENT_SECRET in headscale-vps/secrets.sops.yaml.
# OIDC ships OFF in compose (boot-panic risk) — staged for the operator flip,
# so nothing in this stack reads the key yet. Filled by sops-gen.
# openssl rand -hex 32
WF_OIDC_CLIENT_SECRET=changeme_hex32
