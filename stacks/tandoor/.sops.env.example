# Tandoor — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/tandoor.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file)
# — Django's get_random_secret_key() can emit one.
# BARE Django names on purpose, which is why Tandoor and Wger are separate
# stacks: env_file hands every service in a project the whole .env.

# Django
# UNSET DOES NOT CRASH: settings.py falls back to the literal
# 'INSECURE_STANDARD_KEY_SET_IN_ENV' from the public repo and boot.sh only
# warns, so every cookie is signed with a published key. openssl rand -hex 32
SECRET_KEY=changeme_hex32

# Postgres
# The rest of the DB settings stay in compose.yaml: with DB_ENGINE and
# POSTGRES_DB absent, Tandoor silently falls back to an EPHEMERAL in-container
# SQLite. Keeping them out means a lost .env is an auth error, not a phantom
# database. openssl rand -hex 24
POSTGRES_PASSWORD=changeme_hex24

# Superuser
# Created by tandoor_init through `manage.py shell` (there is no env-var or
# REST path; /setup/ is a browser form that closes once any user exists) plus
# the app's own create_space_for_user. Do NOT use `manage.py seed_basic_data` —
# it is a developer fixture that creates test/test. openssl rand -base64 24
TANDOOR_ADMIN_USER=idan
TANDOOR_ADMIN_EMAIL=idan@idanreed.com
TANDOOR_ADMIN_PASSWORD=changeme_strong_password

# OIDC
# Interpolated into SOCIALACCOUNT_PROVIDERS in compose. Twin of
# TANDOOR_OIDC_CLIENT_SECRET in headscale-vps/secrets.sops.yaml; filled by
# sops-gen. openssl rand -hex 32
TANDOOR_OIDC_CLIENT_SECRET=changeme_hex32
