# Firefly III — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/firefly.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).

# Laravel
# NEVER ROTATE: it encrypts the Passport keypair, so rotating invalidates every
# personal access token including the importer's. Must be EXACTLY 32 CHARS (or
# `base64:` + 32 decoded bytes) — any other length fails with a misleading
# "Auth driver [remote_user_guard] ... is not defined".
# head -c 24 /dev/urandom | base64
APP_KEY=changeme_exactly_32_characters!!
# The host cron timer hits GET /api/v1/cron/$STATIC_CRON_TOKEN unauthenticated
# — the token IS the credential — and it must be EXACTLY 32 chars or the route
# 500s. Without it, recurring transactions never fire. openssl rand -hex 16
STATIC_CRON_TOKEN=changeme_exactly_32_hex_chars!!

# Postgres
# Both spellings hold the SAME value: POSTGRES_PASSWORD initialises the role,
# DB_PASSWORD is what Laravel connects with. openssl rand -hex 24
POSTGRES_PASSWORD=changeme_hex24
DB_PASSWORD=changeme_same_value_as_POSTGRES_PASSWORD

# Data importer
# CANNOT BE GENERATED — a Firefly personal access token, created only from an
# authenticated browser session: log in through Authentik, /profile -> OAuth ->
# Create new token (scope: all). Confirm the outpost sends your EMAIL first;
# remote_user_guard makes whatever arrives the owner PERMANENTLY. Empty is fine
# (the importer loads and simply cannot reach Firefly). Never set
# FIREFLY_III_CLIENT_ID — the OAuth code flow fatals under RemoteUserGuard.
FIREFLY_III_ACCESS_TOKEN=

# SimpleFIN
# ONE-TIME-USE: a base64-encoded Bridge *claim URL*, not an access URL. The
# first import exchanges it for a durable access URL that the Bridge then
# invalidates, and that access URL is stored in the importer's downloadable
# config JSON — never here. So there is no scheduled sync, and rotating means a
# new Bridge connection. See ServerNotes _todo.md "Wire SimpleFIN into Firefly".
SIMPLEFIN_TOKEN=changeme_base64_simplefin_claim_url
