# Mealie stack secrets (services VM)
# Copy to .sops.env and encrypt with:
#   sops -e -i .sops.env
# (encryption needs only the public key in .sops.yaml — no sudo, no age key.)
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/mealie.sops.env must all carry EXACTLY the same keys — the
# stack-env-drift lint fails on any difference.
#
# Reminder from CLAUDE.md: any value containing '$' must be single-quoted in
# the plaintext before encrypting — the decrypt-and-source path expands it
# otherwise. None of the generators below emit '$'.
#
# ⚠ WHAT IS DELIBERATELY NOT HERE:
#   - No SECRET / SESSION_SECRET: Mealie generates and persists both into
#     /app/data (.secret / .session_secret on the /mnt/fast/mealie mount) at
#     first boot — settings.py's determine_secrets. They ride the fast-tier
#     backup; losing them logs everyone out but loses no data.
#   - No POSTGRES_* and no DB_ENGINE: this stack is SQLITE ON PURPOSE, and
#     DB_ENGINE=sqlite is pinned in compose.yaml where a raced or edited
#     .env can never flip it. The reasoning — Mealie's engine switch treats
#     ANY value but the exact string `postgres` as sqlite, silently — is in
#     the compose header. Do not "upgrade" this file with database keys.

# ---------------------------------------------------------------------------
# The first REAL admin, created by mealie_init — which then DELETES the
# admin Mealie itself pre-creates at boot (changeme@example.com/MyPassword,
# username `admin`: both strings are in the public repository and v3 removed
# the env vars that used to change them).
#
# ⚠ MEALIE_ADMIN_USER must not be `admin` (the default account's username —
# creating the real one would conflict before the default is retired) and
# the password must not be `MyPassword`; mealie-init.py refuses both.
#
# ⚠ Rotating MEALIE_ADMIN_PASSWORD after first deploy does NOTHING by
# itself: mealie_init never touches an existing account's password (a
# redeploy must not clobber a password changed in the UI). Change it in the
# UI first, then mirror it here so a future re-provision seeds the same one.
# Generate the password: openssl rand -base64 24
# ---------------------------------------------------------------------------
MEALIE_ADMIN_USER=idan
MEALIE_ADMIN_EMAIL=idan@idanreed.com
MEALIE_ADMIN_PASSWORD=changeme_strong_password

# ---------------------------------------------------------------------------
# OIDC client secret — INERT until OIDC_AUTH_ENABLED=true in compose.yaml,
# which stays false until the Authentik `mealie` provider exists (needs the
# production age key for the VPS secrets, the tandoor/books posture). Mealie
# reads the BARE name OIDC_CLIENT_SECRET; this stack's .env feeds only the
# two mealie containers, so the bare name collides with nothing.
# Value: the Client Secret from the Authentik provider, once created.
# ---------------------------------------------------------------------------
OIDC_CLIENT_SECRET=changeme_authentik_mealie_client_secret
