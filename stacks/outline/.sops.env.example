# Outline stack secrets (services VM)
# Copy to .sops.env and encrypt with:
#   sops -e -i .sops.env
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/outline.sops.env must all carry EXACTLY the same keys — the
# stack-env-drift lint fails on any difference.
#
# ⚠ Values containing '$' must be SINGLE-QUOTED (finding #30):
# decrypt-sops-envs writes a plain .env that is later sourced, and an unquoted
# '$' is expanded away silently. `openssl rand -hex` never emits one; a
# hand-typed password might.

# ---------------------------------------------------------------------------
# SECRET_KEY — signs sessions and encrypts data at rest in the database.
# Rotating it logs everyone out and makes previously encrypted fields
# unreadable, so treat it as permanent once documents exist.
# Generate: openssl rand -hex 32   (must be 64 hex characters)
# ---------------------------------------------------------------------------
SECRET_KEY=changeme_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# UTILS_SECRET — the shared secret that authenticates Outline's internal
# utility endpoints (/api/cron.*). It DEFAULTS TO THE EMPTY STRING (read out
# of the image's build/server/env.js — there is no validation and no error if
# it is missing), so leaving it unset is a silent state, not a loud one.
# Set it, and to a DIFFERENT value from SECRET_KEY: sharing one value would
# make a leaked session key also drive those endpoints.
# Generate: openssl rand -hex 32   (a DIFFERENT value from SECRET_KEY)
# ---------------------------------------------------------------------------
UTILS_SECRET=changeme_openssl_rand_hex_32_different_value

# ---------------------------------------------------------------------------
# Postgres. Two names, one value: POSTGRES_PASSWORD initialises the role in
# the outline_db container, DATABASE_URL is what the app connects with. The
# host part (outline_db) and the user/database (outline) are load-bearing for
# nixos/backup-prepare.sh's pg_dumpall loop — do not rename them here without
# renaming them there.
# Generate: openssl rand -hex 24
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme_openssl_rand_hex_24
DATABASE_URL=postgres://outline:changeme_openssl_rand_hex_24@outline_db:5432/outline

# ---------------------------------------------------------------------------
# OIDC_CLIENT_SECRET — the Authentik client secret for the `outline` provider.
#
# 🚨 THIS IS THE LOGIN. Outline has no local accounts; a wrong or empty value
# means every sign-in fails at the token exchange with a generic error, at
# login time, with nothing in the container's startup log (the container will
# be HEALTHY throughout).
#
# THE OTHER HALF lives in headscale-vps/secrets.sops.yaml as
# OUTLINE_OIDC_CLIENT_SECRET: the blueprint
# (headscale-vps/authentik/blueprints/custom/outline-oidc.yaml) reads it via
# `!Env OUTLINE_OIDC_CLIENT_SECRET`, and the value here must match the VPS
# copy exactly — the same three-way rotation coupling Immich has.
# Generate: openssl rand -hex 32, one value into both files.
# ---------------------------------------------------------------------------
OIDC_CLIENT_SECRET=changeme_authentik_outline_client_secret
