# Outline — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/outline.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).

# Session
# Signs sessions and encrypts data at rest — treat as permanent once documents
# exist. Must be 64 hex characters. openssl rand -hex 32
SECRET_KEY=changeme_hex32
# Authenticates /api/cron.*. It DEFAULTS TO THE EMPTY STRING with no error, so
# unset is a silent state. Use a DIFFERENT value from SECRET_KEY.
# openssl rand -hex 32
UTILS_SECRET=changeme_hex32_different_value

# Postgres
# compose.yaml builds the app's DATABASE_URL from POSTGRES_PASSWORD; the
# DATABASE_URL key below is INERT and stays only so the three files keep one
# key set (drop it from all three together). The host (outline_db) and the
# user/database (outline) are load-bearing for nixos/backup-prepare.sh.
# openssl rand -hex 24
POSTGRES_PASSWORD=changeme_hex24
DATABASE_URL=postgres://outline:changeme_hex24@outline_db:5432/outline

# OIDC
# THIS IS THE LOGIN — Outline has no local accounts, so a wrong or empty value
# fails every sign-in at token exchange while the container stays healthy.
# Twin of OUTLINE_OIDC_CLIENT_SECRET in headscale-vps/secrets.sops.yaml: one
# value into both files. openssl rand -hex 32
OIDC_CLIENT_SECRET=changeme_hex32
