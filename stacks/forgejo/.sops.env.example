# Forgejo — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/forgejo.sops.env.
# Forgejo self-generates SECRET_KEY / INTERNAL_TOKEN / JWT into app.ini, so the
# cross-host OIDC secret is the only thing here.

# OIDC
# Twin of FORGEJO_OIDC_CLIENT_SECRET in headscale-vps/secrets.sops.yaml (one
# value, both files — sops-gen draws it into each). Read by forgejo-init to
# seed the DB auth source; the main container never sees it.
# openssl rand -hex 32
FORGEJO_OIDC_CLIENT_SECRET=changeme_hex32
