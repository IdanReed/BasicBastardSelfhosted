# Forgejo application secrets.
#
# Forgejo self-generates its OWN private material (SECRET_KEY, INTERNAL_TOKEN,
# JWT secrets) into app.ini inside the volume, so this file holds ONLY the
# cross-host OIDC client secret — the twin of headscale-vps
# FORGEJO_OIDC_CLIENT_SECRET (secrets-gen manifest forgejo/oidc). It is read by
# forgejo-init to seed the DB auth source (`forgejo admin auth add-oauth`); the
# main forgejo container never sees it. Filled by sops-gen; generate one value:
# openssl rand -hex 32 (sops-gen draws it into both files at once).
FORGEJO_OIDC_CLIENT_SECRET=changeme_generate_with_openssl_rand_hex
