# Caddy secrets (services VM)
# Copy to .sops.env and encrypt with:
#   SOPS_AGE_KEY_FILE=../../sops_age_key.txt sops -e -i .sops.env

# This host's tailnet IP. Caddy binds ONLY to this address, so nothing it
# serves is reachable from the LAN or the internet.
# Find it with: tailscale ip -4
TAILNET_IP=100.64.0.2

# Cloudflare API token used for DNS-01 ACME challenges.
#
# Scope it as tightly as Cloudflare allows: Zone:DNS:Edit on idanreed.com only.
# Note this is the same zone that holds the public headscale.idanreed.com
# record, so the token can rewrite production DNS. Consider CNAME-delegating
# _acme-challenge to a separate zone if that matters to you.
CLOUDFLARE_API_TOKEN=changeme_cloudflare_zone_dns_edit_token
