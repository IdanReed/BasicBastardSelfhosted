# Caddy — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/caddy.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).

# Tailnet
# Caddy binds ONLY to this address, so nothing it serves is LAN- or
# internet-reachable. tailscale ip -4
TAILNET_IP=100.64.0.2

# Cloudflare DNS-01
# Scope as tightly as Cloudflare allows: Zone:DNS:Edit on idanreed.com only.
CLOUDFLARE_API_TOKEN=changeme_cloudflare_zone_dns_edit_token

# Log ingest
# Bearer the vlogs-ingest.svc.idanreed.com vhost demands. Cross-host twin of
# VLOGS_INGEST_TOKEN in headscale-vps/secrets.sops.yaml — a mismatch 401s every
# push silently (the Gatus "victorialogs (vps ingest)" probe is the alarm).
# openssl rand -hex 32
VLOGS_INGEST_TOKEN=changeme_hex32
