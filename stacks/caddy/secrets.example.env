# Caddy — the keys stored in secrets.sops.json, one value each (`sopsgen
# apply` fills generated ones, `sopsedit` the rest). Values built from other
# secrets live in env.nix. Key set must match secrets.sops.json and
# tests/fixtures/stacks/caddy.sops.json.

# Tailnet
# Caddy binds ONLY to this address, so nothing it serves is LAN- or
# internet-reachable. tailscale ip -4
TAILNET_IP=100.64.0.2

# Cloudflare DNS-01
# Scope as tightly as Cloudflare allows: Zone:DNS:Edit on idanreed.com only.
CLOUDFLARE_API_TOKEN=changeme_cloudflare_zone_dns_edit_token

