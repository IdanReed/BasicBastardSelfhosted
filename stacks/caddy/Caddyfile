	# ------------------------------------------------------------------
	# Books stack (stacks/books, 10150-10152). kavita and audiobookshelf
	# drive their own OIDC and get no forward auth; shelfmark has no auth
	# of its own and does. Both OIDC apps ship ready-and-OFF on local
	# accounts until the operator lands the client secrets — neither is
	# ever unauthenticated, which is what makes the OFF state safe.
	# ------------------------------------------------------------------

	@kavita host kavita.svc.idanreed.com
	handle @kavita {
		# NO forward auth, and not a preference: OPDS and KOReader sync
		# authenticate by an API key in the URL from clients that cannot
		# follow a redirect. Excluding both prefixes would leave the API key
		# as the only protection anyway, with twice the moving parts.
		reverse_proxy localhost:10150
	}

	@shelfmark host shelfmark.svc.idanreed.com
	handle @shelfmark {
		# Its own AUTH_METHOD defaults to `none`, so the loopback publish is
		# otherwise the only thing in front of it.
		import protected
		reverse_proxy localhost:10151
	}

	@audiobookshelf host audiobookshelf.svc.idanreed.com
	handle @audiobookshelf {
		# NO forward auth: it would break the audiobookshelf://oauth handoff
		# and every API-key client. Caddy's default X-Forwarded-Proto is what
		# keeps the OIDC redirect_uri https.
		reverse_proxy localhost:10152
	}

	# ------------------------------------------------------------------
	# Automation stack (stacks/automation, ports 10250-10252). Mosquitto
	# has no route on purpose: MQTT is not HTTP, and its consumers
	# (Frigate, Home Assistant) reach it by service name on the compose
	# network. Reaching it from IoT devices is a second-NIC + firewall
	# job, not a Caddy one.
	# ------------------------------------------------------------------

	@homeassistant host homeassistant.svc.idanreed.com
	handle @homeassistant {
		# NO forward auth, and not a preference: /api/webhook/* is
		# unauthenticated by design and is what the mobile app posts location
		# to, and every bearer-token REST and websocket client would be
		# bounced to a login page. HA authenticates itself.
		#
		# stream_close_delay because HA is one long-lived websocket: without
		# it a `caddy reload` force-closes every session.
		reverse_proxy localhost:10250 {
			stream_close_delay 30s
		}
	}

	@frigate host frigate.svc.idanreed.com
	handle @frigate {
		# Frigate's own auth is disabled and its nginx re-injects exactly the
		# five X-Authentik-* headers this snippet copies, so identity comes
		# from Authentik and Frigate maps it to admin/viewer.
		#
		# 🚨 Rollout order matters doubly here: with `auth.enabled: false`, an
		# unprotected Frigate is an unauthenticated NVR.
		import protected
		reverse_proxy localhost:10252
	}

	# ------------------------------------------------------------------
	# Tracking domain (10300-10349), three compose stacks, grouped here by
	# domain because that is how the routes are used.
	#
	# bookstack/homebox/karakeep drive their own OIDC and each has API or
	# mobile clients a redirect would break, so none gets forward auth.
	# firefly and its importer are the opposite case; dawarich has native
	# OIDC but cannot be proxied. See each block.
	# ------------------------------------------------------------------

	@bookstack host bookstack.svc.idanreed.com
	handle @bookstack {
		reverse_proxy localhost:10300
	}

	@homebox host homebox.svc.idanreed.com
	handle @homebox {
		# Homebox builds its OIDC redirect URI from request headers, so
		# HBOX_OPTIONS_TRUST_PROXY and HBOX_OPTIONS_HOSTNAME are both set
		# in its compose — Caddy's defaults supply what it needs.
		# WebSockets on /api/v1/ws/events; Caddy upgrades automatically.
		reverse_proxy localhost:10301
	}

	@karakeep host karakeep.svc.idanreed.com
	handle @karakeep {
		# Do NOT add CORS headers here: the app already emits
		# Access-Control-Allow-Origin from two layers of its own, and a
		# third produces duplicates that browsers reject outright.
		reverse_proxy localhost:10302
	}

	@firefly host firefly.svc.idanreed.com
	handle @firefly {
		# Forward auth is Firefly's ONLY SSO path — no OIDC in core, and the
		# feature is milestoned with no date.
		#
		# 🚨 The highest-stakes (protected) import in the fleet: Firefly's
		# remote_user_guard does NO validation of the header, so whatever
		# string arrives IS the account and the first one seen becomes the
		# owner. Any path to :10303 that skips this handle is a total
		# compromise — hence the loopback-only publish.
		#
		# ^/api/.* is excluded on the AUTHENTIK side, not here: Firefly's API
		# authenticates with Passport PATs under a separate guard, and
		# forward auth would 302 every API client first.
		import protected
		reverse_proxy localhost:10303
	}

	@firefly-importer host firefly-importer.svc.idanreed.com
	handle @firefly-importer {
		# 🚨 A hard requirement, not defence in depth: the importer's UI has
		# no authentication of its own and cannot be given any in PAT mode,
		# while holding a full-privilege Firefly API token. Its own provider
		# rather than Firefly's, because the outpost matches on external_host.
		#
		# No /api exclusion: it has no API for clients, only the browser UI
		# and outbound calls that never traverse Caddy.
		import protected
		reverse_proxy localhost:10305
	}

	@dawarich host dawarich.svc.idanreed.com
	handle @dawarich {
		# NO forward auth, and not a preference: the tracker clients
		# authenticate with an API key IN THE QUERY STRING and cannot follow
		# a redirect, and the exclusion list would have to cover the entire
		# data plane. It has native OIDC instead, shipping ready and off.
		#
		# 🚨 Any smoke test of this route must fetch `/` with the real Host
		# header, NEVER /api/v1/health — Rails' host_authorization excludes
		# the health path, so a wrong APPLICATION_HOSTS gives a healthy
		# container and a 403 on every browser request.
		reverse_proxy localhost:10304
	}

	@ghostfolio host ghostfolio.svc.idanreed.com
	handle @ghostfolio {
		# NO forward auth: accounts are identified by a security token whose
		# hash is salted with ACCESS_TOKEN_SALT, so this route is
		# authenticated, just not by Authentik. Its native OIDC is still
		# labelled experimental upstream.
		#
		# ⚠ If forward auth is ever added it cannot be a bare `import
		# protected`: /api/v1/* authenticates with its own bearer token and
		# would need the skip_path_regex treatment Firefly's provider has.
		reverse_proxy localhost:10306
	}

	@owl host owl.svc.idanreed.com
	handle @owl {
		# 🚨 THIS IMPORT IS THE ENTIRE ACCESS CONTROL FOR THIS SERVICE. Owl is
		# a Streamlit app with no authentication of any kind, so removing this
		# line publishes somebody's retirement plan to every tailnet user.
		#
		# 🚨 DO NOT EXCLUDE /_stcore/*, here or in the provider's
		# skip_path_regex: Streamlit's websocket IS the application, and
		# exempting it would leave this handle protecting a login page in
		# front of a wide-open app. (Dawarich above is the same reasoning
		# reaching the opposite conclusion — there the data plane cannot be
		# covered, so forward auth is refused outright rather than faked.)
		#
		# Caddy needs nothing extra for the websocket: forward_auth rewrites
		# only the auth subrequest's Host, so the original reaches Streamlit's
		# Origin check, and the authentik cookie rides the same-origin
		# handshake. If authentik ever answered 101 to the forwarded Upgrade
		# this would hang, and the fix is `header_up -Connection`, still not
		# an exclusion.
		#
		# ⚠ NOT VERIFIED END TO END — no suite has a live outpost. Check by
		# hand on first deploy.
		#
		# ⚠ Expected rough edge: on session expiry with the tab open, the
		# socket's reconnect gets a 302 that browsers will not follow, so the
		# UI silently stops updating until the page is reloaded.
		import protected
		reverse_proxy localhost:10307
	}

	@actual host actual.svc.idanreed.com
	handle @actual {
		# Native login (server password today, native OIDC once the
		# Authentik secret lands) — NO forward auth: every Actual client,
		# including the @actual-app/api library, authenticates by POSTing
		# the password for a session token and cannot follow an IdP
		# redirect. The loopback publish of :10308 is the other half of
		# this decision.
		reverse_proxy localhost:10308
	}

	@wealthfolio host wealthfolio.svc.idanreed.com
	handle @wealthfolio {
		# NO forward auth, deliberately — the ghostfolio posture, applied
		# to its bake-off rival: Wealthfolio ships with its own password
		# login armed (WF_AUTH_PASSWORD_HASH, Argon2id) and native OIDC
		# ready-but-OFF (discovery is BOOT-FATAL with no override; read
		# the compose file before ever turning it on).
		# Two Wealthfolio-specifics of this route:
		#   - WF_COOKIE_SECURE=auto keys the session cookie's Secure
		#     flag on X-Forwarded-Proto, which reverse_proxy sends — do
		#     not strip it.
		#   - WF_CORS_ALLOW_ORIGINS is pinned to EXACTLY
		#     https://wealthfolio.svc.idanreed.com. Renaming this vhost
		#     without changing that env leaves every curl probe green
		#     and every browser login broken on CORS.
		# ⚠ If forward auth is ever added, pair it with
		# WF_AUTH_REQUIRED=false (upstream's documented edge-auth mode)
		# or it is two logins.
		reverse_proxy localhost:10309
	}

	@windmill host windmill.svc.idanreed.com
	handle @windmill {
		# The only SSO Windmill can have — OIDC login is an Enterprise
		# feature. It gates ACCESS ONLY: Windmill does not consume
		# X-Authentik-*, so a local login still follows. Two logins,
		# permanently; that is the trade.
		#
		# 🚨 IN-FLEET CALLERS MUST NOT USE THIS VHOST — forward auth 302s
		# every POST /api/w/<ws>/jobs/run/*, and an Authentik carve-out for
		# ^/api/.* would expose the whole authenticated API. Browsers come
		# here, machines call 127.0.0.1:10253 direct.
		#
		# ⚠ Never set `disable_password_login` in Instance Settings: with no
		# OAuth provider — the permanent state on OSS — it is a self-lockout.
		import protected
		reverse_proxy localhost:10253
	}

	# ------------------------------------------------------------------
	# Notes/Sync stack (stacks/notes-sync, ports 10200-10201). Syncthing's
	# BEP port 22000 has no route on purpose: it is not HTTP, and peers
	# reach it through the bare publish rather than through Caddy.
	# ------------------------------------------------------------------

	@rmfakecloud host rmfakecloud.svc.idanreed.com
	handle @rmfakecloud {
		# NO forward auth, and not close: the tablet is a non-interactive
		# client holding an rmfakecloud JWT that cannot follow a 302, and only
		# /ui/* is a browser path — the exclusion list would BE the data
		# plane. rmfakecloud authenticates itself (argon2id, JWT admin claim).
		#
		# 🚨 Do not enable this route before notes-sync-init has run: on an
		# empty data directory the first POST to /ui/api/login creates an
		# admin out of whatever credentials arrive.
		reverse_proxy localhost:10200
	}

	@syncthing host syncthing.svc.idanreed.com
	handle @syncthing {
		# Forward auth on the GUI, with Syncthing's own seeded credential
		# underneath — the API key is a full-admin bypass, so anything
		# reaching the port directly must still meet a lock.
		#
		# ⚠ This route only works because the container keeps
		# STGUIADDRESS=0.0.0.0:8384. Unsetting it (as upstream's README says)
		# installs localhostMiddleware, after which every request with this
		# Host gets a bare 403 "Host check error" and nothing explains it.
		#
		# 🚨 A client-supplied X-API-Key bypasses GUI auth entirely, and Caddy
		# forwards unknown headers by default.
		request_header -X-API-Key
		import protected
		reverse_proxy localhost:10201
	}

	@silverbullet host silverbullet.svc.idanreed.com
	handle @silverbullet {
		# Forward auth with SilverBullet's own SB_USER login underneath — two
		# locks, since it cannot read X-Authentik-* headers.
		#
		# NO skip_path_regex on its provider, measured rather than omitted:
		# every path that answers without a session is a same-origin browser
		# request carrying the Authentik cookie, and nothing dials this vhost
		# non-interactively — the git mirror uses Forgejo's loopback publish.
		# The PWA service worker, which forward auth would genuinely break, is
		# turned off in the compose file instead of exempted here.
		import protected
		reverse_proxy localhost:10202
	}

	@outline host outline.svc.idanreed.com
	handle @outline {
		# NO forward auth, and not a preference: Outline has no local
		# accounts at all, so the outpost would 302 the /auth/oidc.callback
		# leg of its own login flow.
		#
		# ⚠ Consequently this vhost is open to the tailnet until the OIDC
		# client secret is real — it renders its sign-in page to anyone who
		# can reach the name, and the first successful sign-in becomes the
		# workspace OWNER.
		reverse_proxy localhost:10203
	}

	# ------------------------------------------------------------------
	# Food domain (10350-10399). Two stacks, one per app — see
	# stacks/tandoor/compose.yaml's header for why they cannot share one.
	# ------------------------------------------------------------------

	@tandoor host tandoor.svc.idanreed.com
	handle @tandoor {
		# NO forward auth: Tandoor drives its own OIDC against Authentik and
		# ships OIDC-ready and OIDC-off, running on the local superuser that
		# tandoor_init creates until the client secret lands. Same posture as
		# the books stack.
		#
		# ⚠ Never set REMOTE_USER_AUTH on this service to make forward auth
		# work: doing so puts RemoteUserBackend in AUTHENTICATION_BACKENDS,
		# and the /setup/ view refuses to run at all when it is there — so a
		# fresh instance would have no way in.
		reverse_proxy localhost:10350
	}

	@wger host wger.svc.idanreed.com
	handle @wger {
		# Forward auth. Wger has no OIDC in this version, and its own login
		# stays underneath — the account wger_init provisions is the fallback
		# if the outpost is unreachable.
		#
		# The upstream port is the NGINX SIDECAR, not gunicorn: wger/server
		# serves no static files at all (no whitenoise in INSTALLED_APPS), so
		# proxying straight to the app would render a page with no CSS and no
		# JS — plausible-looking and completely broken.
		import protected
		reverse_proxy localhost:10351
	}

	@mealie host mealie.svc.idanreed.com
	handle @mealie {
		# NO forward auth: Mealie drives its own OIDC against Authentik
		# (plain OIDC_* env vars; discovery is lazy, so configuring it is
		# not boot-fatal) and ships OIDC-ready and OIDC-off, running on the
		# local admin that mealie_init creates until the client secret
		# lands. Same posture as tandoor next door.
		reverse_proxy localhost:10352
	}

	# ------------------------------------------------------------------
	# Vaultwarden (Util range, 10400 — its own stack, see
	# stacks/vaultwarden/compose.yaml for why).
	#
	# This is the only route in the fleet where forward auth is applied to
	# ONE PATH rather than to the host, and both halves of that are
	# deliberate.
	# ------------------------------------------------------------------

	@vaultwarden host vaultwarden.svc.idanreed.com
	handle @vaultwarden {
		# /admin gets forward auth AND keeps its ADMIN_TOKEN.
		# DISABLE_ADMIN_TOKEN exists for exactly this arrangement and is
		# deliberately NOT set: with both, a forward-auth outage still leaves
		# the token and a leaked token still needs an Authentik session.
		# The outpost's own path rides along: Authentik's return trip lands on
		# /outpost.goauthentik.io/callback, which only a forward_auth'd request
		# completes — outside the matcher it falls through to Vaultwarden (404).
		@vaultwarden-admin path /admin* /outpost.goauthentik.io/*
		handle @vaultwarden-admin {
			import protected
			reverse_proxy localhost:10400
		}

		# Everything else gets NO forward auth, and not as a preference: the
		# extension, apps and CLI all authenticate with a bearer token and
		# surface a 302 as a generic login failure, and a 302 on the
		# notification websocket's Upgrade makes every client fall back to
		# polling SILENTLY ("my vault takes minutes to sync", no error).
		#
		# The exclusion list would be the entire data plane, and the vault is
		# end-to-end encrypted anyway, so Authentik would only add a perimeter
		# around ciphertext.
		handle {
			reverse_proxy localhost:10400
		}
	}

	@docspace host docspace.svc.idanreed.com
	handle @docspace {
		# NO forward auth: real accounts of its own, plus desktop and mobile
		# clients a 302 would break. Its SSO is SAML 2.0, not OIDC, and is
		# free self-hosted; until that exchange with Authentik happens it runs
		# on the local owner account.
		#
		# 🚨 Document Server has NO route and must never get one: it is served
		# at /ds-vpath/ by this container's own nginx, and publishing it would
		# expose an unauthenticated /healthcheck and a converter.
		reverse_proxy localhost:10404
	}

	@gatus host gatus.svc.idanreed.com
	handle @gatus {
		# 🚨 The ONLY control: Gatus's own `security` block leaves the SPA,
		# /api/v1/config and every uptime-history route on an UNPROTECTED
		# router, so anyone reaching the port reads everything.
		#
		# ⚠ Gatus's OIDC must never be enabled: it panics at startup if
		# discovery fails, which would restart-loop the one service that has
		# to stay up when others do not.
		#
		# ⚠ External push endpoints would break under forward auth and need an
		# Authentik carve-out. This design does not use them.
		import protected
		reverse_proxy localhost:10450
	}

	@beszel host beszel.svc.idanreed.com
	handle @beszel {
		# Forward auth with Beszel's own PocketBase login underneath. OIDC
		# cannot work here: its provider config lives inside data.db with no
		# environment variable for any part of it.
		#
		# 🚨 Browser-only, which is what makes forward auth safe: the AGENT
		# dials 127.0.0.1:10452 on the host network, and pointed at this
		# hostname instead it would silently fall back to SSH pull mode rather
		# than report the 302.
		#
		# ⚠ Do not "improve" this with TRUSTED_AUTH_HEADER +
		# DISABLE_PASSWORD_AUTH: the header would then be trusted on EVERY
		# request, and unlike Firefly's case the port is genuinely reachable
		# without the proxy, so anything on the host could set it and be admin.
		import protected
		reverse_proxy localhost:10452
	}

	@grafana host grafana.svc.idanreed.com
	handle @grafana {
		# Forward auth with Grafana's own admin login underneath. Two logins
		# is the deliberate cost of not using Grafana's auth.proxy header
		# mode, which would trust X-Authentik-* from anything reaching
		# 127.0.0.1:10455 — and this is the service you want working when the
		# VPS running the outpost is the thing that broke.
		#
		# 🚨 Browser-only, which is what makes forward auth safe: nothing
		# talks to Grafana programmatically, and the log INGESTION path does
		# not come through here at all (Alloy pushes to victorialogs:9428 over
		# the compose network). A forward-auth 302 on a push endpoint is
		# silently dropped telemetry, so no ingest path may ever `import
		# protected` — see @vlogs_ingest below, the one machine-facing route.
		#
		# ⚠ Grafana Live is the one feature the outpost breaks, so it is
		# turned off in compose.yaml rather than left to fail confusingly.
		import protected
		reverse_proxy localhost:10455
	}

	# -----------------------------------------------------------------------
	# VictoriaLogs ingest — the ONE machine-facing route in this file
	# -----------------------------------------------------------------------
	# Exists so the headscale VPS can ship its journal here
	# (headscale-vps/modules/log-shipper.nix) — the journal holding every
	# fail2ban ban and Authentik login_failed, i.e. the fleet's only
	# publicly-exposed auth surface.
	#
	# 🚨 A VHOST RATHER THAN A TAILNET BIND, because publishing VictoriaLogs
	# on ${TAILNET_IP} would break the loopback-only publish contract every
	# stack is held to AND hand every tailnet peer unauthenticated read and
	# delete over the fleet's logs — it has no authentication of its own.
	#
	# 🚨 THE PATH ALLOWLIST IS THE SECURITY BOUNDARY. VictoriaLogs serves
	# /insert/*, the full /select/* query api and /internal/* (force_merge,
	# and in some builds deletion) on ONE port. Adding a second path here is a
	# posture change, not a convenience.
	#
	# 🚨 NO `import protected`: forward auth answers an unauthenticated push
	# with a 302, which Alloy treats as a non-retryable success — the lines
	# are then gone. Machine ingest authenticates with a bearer token.
	#
	# The token is a cross-host twin from secrets-gen/manifest.yaml, checked
	# on all three sides by the vlogs-ingest-contract lint.
	@vlogs_ingest host vlogs-ingest.svc.idanreed.com
	handle @vlogs_ingest {
		# Ordering, measured with `caddy adapt` rather than assumed: `respond`
		# outranks `reverse_proxy` in directiveOrder however they are written,
		# and same-directive `respond`s keep source order. If the proxy ran
		# first this vhost would be an unauthenticated write endpoint.
		#
		# ⚠ Not a constant-time comparison — caddy's header matcher is plain
		# string equality. Against a 256-bit token reachable only over the
		# tailnet that is a recorded tradeoff, not an oversight.
		#
		# 🚨 FAIL-CLOSED GUARD FOR AN UNSET TOKEN, and it must come FIRST.
		# `{$VLOGS_INGEST_TOKEN}` is substituted at ADAPT time, so a missing
		# key degrades the check below to the literal "Bearer " — an open
		# write endpoint onto the fleet's log store. That state is real, not
		# hypothetical: a push deploys this file the minute it lands, while
		# the token appears only when an operator runs `sopsgen apply` and
		# switches. 503 rather than 401 because it is a misconfiguration, and
		# because the gatus probe expects 401 and so alerts on it.
		@empty_token {
			header Authorization "Bearer "
		}
		respond @empty_token "ingest token not configured on this host" 503

		# ⚠ BLOCK FORM, not the one-line `@name not header …`: this is the only
		# site block in the fleet, so a Caddyfile that fails to parse takes
		# down every service on the VM. The block form is what
		# headscale-vps/modules/caddy.nix already uses against a real caddy in
		# tests/suites/vps.nix; the one-liner is only documented.
		@unauthorized {
			not header Authorization "Bearer {$VLOGS_INGEST_TOKEN}"
		}
		respond @unauthorized "unauthorized" 401

		@not_ingest {
			not path /insert/loki/api/v1/push
		}
		respond @not_ingest "this vhost accepts log ingest only" 403

		reverse_proxy localhost:10456
	}

	# Anything not matched above. Without this a stray subdomain would get a
	# blank 200 from the wildcard site.
	handle {
		respond "No such service" 404
	}
}
