	}

	# ------------------------------------------------------------------
	# Books stack (stacks/books, ports 10150-10152). Auth per the overview
	# Auth column: kavita and audiobookshelf drive their OWN OIDC against
	# Authentik, so neither gets forward auth; shelfmark has no auth of its
	# own and does (AUTH_METHOD=proxy in its compose reads the
	# X-Authentik-* headers the (protected) snippet copies).
	#
	# Both OIDC apps ship OIDC-READY and OIDC-OFF today: the client secrets
	# need the production age key to reach headscale-vps/secrets.sops.yaml,
	# so until the operator lands them each app authenticates with its own
	# local accounts (seeded by books-init). Neither is ever unauthenticated
	# — that is why the OFF state is safe to ship (annex §8.4).
	# ------------------------------------------------------------------

	@kavita host kavita.svc.idanreed.com
	handle @kavita {
		# NO forward auth, and this one is not a preference: OPDS
		# (/api/opds/{key}) and KOReader progress sync
		# (/api/koreader/{key}/...) authenticate by an API key embedded in
		# the URL, from non-browser clients that cannot follow an OIDC
		# redirect or hold a session cookie. Forward auth would have to
		# exclude both prefixes anyway, at which point the API key is the
		# only protection and the moving parts have doubled.
		reverse_proxy localhost:10150
	}

	@shelfmark host shelfmark.svc.idanreed.com
	handle @shelfmark {
		# Forward auth: shelfmark's own AUTH_METHOD defaults to `none`, so
		# the loopback publish is otherwise the only thing in front of it.
		# Rollout order is load-bearing — the blueprint entry in
		# headscale-vps/authentik/blueprints/custom/forward-auth.yaml plus a
		# VPS rebuild must land BEFORE this route syncs, or every request
		# here 404s (see the (protected) header above).
		import protected
		reverse_proxy localhost:10151
	}

	@audiobookshelf host audiobookshelf.svc.idanreed.com
	handle @audiobookshelf {
		# NO forward auth: it would break the mobile app's
		# audiobookshelf://oauth handoff and every API-key client, the same
		# call as immich and jellyfin. Caddy already sends the two headers
		# audiobookshelf needs (Host, X-Forwarded-Proto) by default — the
		# latter matters because the OIDC redirect_uri is built from it, and
		# without it audiobookshelf offers Authentik an http:// callback.
		reverse_proxy localhost:10152
	}

	# ------------------------------------------------------------------
	# Automation stack (stacks/automation, ports 10250-10252). Mosquitto
	# has no route on purpose: MQTT is not HTTP, and its consumers
	# (Frigate, Home Assistant) reach it by service name on the compose
	# network. Reaching it from IoT devices is a second-NIC + firewall
	# job, not a Caddy one.
	# ------------------------------------------------------------------

	@homeassistant host homeassistant.svc.idanreed.com
	handle @homeassistant {
		# NO forward auth, and this one is not a preference:
		# /api/webhook/* is unauthenticated BY DESIGN and is what the
		# mobile app posts location to, and every bearer-token REST and
		# websocket client would be bounced to a login page. The
		# canonical header-auth component for HA is archived, and
		# hass-oidc-auth's own docs say to remove proxy auth. HA
		# authenticates itself (local accounts today, Authentik via
		# hass-oidc-auth later — annex §7.3).
		#
		# Home Assistant is one long-lived websocket, so without this a
		# `caddy reload` force-closes every session and the UI visibly
		# reconnects. Caddy needs nothing else for websockets — do not
		# port nginx's Connection/Upgrade headers here.
		reverse_proxy localhost:10250 {
			stream_close_delay 30s
		}
	}

	@frigate host frigate.svc.idanreed.com
	handle @frigate {
		# Forward auth, and Frigate meets us more than halfway: its own
		# auth is disabled (stacks/automation/frigate.yaml) and its
		# nginx strips every inbound header before re-injecting a
		# whitelist that contains verbatim the five X-Authentik-*
		# headers the snippet below already copies. So identity comes
		# from Authentik and Frigate maps it to admin/viewer.
		#
		# Rollout order is load-bearing, as always: the blueprint entry
		# plus a VPS rebuild BEFORE this route syncs. Doubly so here —
		# with `auth.enabled: false` in its config, an unprotected
		# Frigate is an unauthenticated NVR.
		import protected
		reverse_proxy localhost:10252
	}

	# ------------------------------------------------------------------
	# Tracking domain (10300-10349). Three separate compose stacks share
	# this range (see stacks/tracking/compose.yaml's header) — the routes
	# are grouped here by domain rather than by stack, because that is how
	# they are used.
	#
	# bookstack/homebox/karakeep drive their OWN OIDC against Authentik, so
	# none gets forward auth: each has native support, and every one of them
	# has API clients or mobile apps that a redirect would break. They ship
	# OIDC-ready and OIDC-off, authenticating with local accounts until the
	# client secrets land — never unauthenticated.
	#
	# firefly and its importer are the opposite case and are the only
	# forward-auth entries in this domain; dawarich has native OIDC but
	# cannot be proxied. See each block.
	# ------------------------------------------------------------------

	@bookstack host bookstack.svc.idanreed.com
	handle @bookstack {
		reverse_proxy localhost:10300
	}

	@homebox host homebox.svc.idanreed.com
	handle @homebox {
		# Homebox builds its OIDC redirect URI from request headers, so
		# HBOX_OPTIONS_TRUST_PROXY and HBOX_OPTIONS_HOSTNAME are both set
		# in its compose — Caddy's defaults supply what it needs.
		# WebSockets on /api/v1/ws/events; Caddy upgrades automatically.
		reverse_proxy localhost:10301
	}

	@karakeep host karakeep.svc.idanreed.com
	handle @karakeep {
		# Do NOT add CORS headers here: the app already emits
		# Access-Control-Allow-Origin from two layers of its own, and a
		# third produces duplicates that browsers reject outright.
		reverse_proxy localhost:10302
	}

	@firefly host firefly.svc.idanreed.com
	handle @firefly {
		# Forward auth is Firefly's ONLY SSO path and will be for a long
		# time: there is no OIDC in core at v6.6.6 or on develop, and the
		# feature is milestoned v9.0.0 with no date.
		#
		# 🚨 This is the highest-stakes (protected) import in the fleet.
		# Firefly's remote_user_guard does NO validation of the header —
		# whatever string arrives IS the account, and the first one seen
		# becomes the owner. Any path to :10303 that does not traverse this
		# handle is a total compromise, which is what the loopback-only
		# publish in stacks/firefly/compose.yaml is for.
		#
		# The provider's skip_path_regex excludes ^/api/.* on the Authentik
		# side, NOT here — Firefly's API authenticates with Passport PATs
		# under a separate guard, and forward auth would 302 every API
		# client before Firefly ever sees the bearer token.
		import protected
		reverse_proxy localhost:10303
	}

	@firefly-importer host firefly-importer.svc.idanreed.com
	handle @firefly-importer {
		# The importer's web UI has NO authentication of its own and cannot
		# be given any in PAT mode, while holding a full-privilege Firefly
		# API token. This import is a hard requirement, not defence in
		# depth — it gets its own provider rather than sharing Firefly's
		# because the outpost matches on external_host.
		#
		# No /api exclusion here: the importer has no API for clients, only
		# the browser UI and its outbound calls to firefly:8080 on the
		# compose network, which never traverse Caddy.
		import protected
		reverse_proxy localhost:10305
	}

	@dawarich host dawarich.svc.idanreed.com
	handle @dawarich {
		# NO forward auth, and this one is not a preference: the tracker
		# clients (Overland, OwnTracks, Traccar, the PWA) authenticate with
		# an API key IN THE QUERY STRING and cannot follow a redirect. The
		# exclusion list would have to cover /api/v1/points,
		# /api/v1/overland/batches, /api/v1/owntracks/points,
		# /api/v1/traccar/points, /api/v1/auth/*, /s/* and /cable — i.e.
		# the entire data plane, reopening exactly what forward auth was
		# meant to close. It has native OIDC instead (SELF_HOSTED=true +
		# omniauth_openid_connect), shipping ready and off.
		#
		# 🚨 Any smoke test of this route must fetch `/` with the real
		# Host: header, NEVER /api/v1/health — Rails' host_authorization
		# explicitly EXCLUDES the health path, so a wrong APPLICATION_HOSTS
		# yields a healthy container and a 403 "Blocked hosts" on every
		# browser request (annex §6).
		#
		# ActionCable lives at /cable; Caddy upgrades websockets with no
		# extra config.
		reverse_proxy localhost:10304
	}

	@windmill host windmill.svc.idanreed.com
	handle @windmill {
		# Forward auth is the ONLY SSO Windmill can have: OIDC/OAuth login
		# is an Enterprise feature and the OSS build has no path to it.
		#
		# ⚠ It gates ACCESS ONLY. Windmill does not consume X-Authentik-*
		# — there is no remote-user guard here (that is Firefly) — so you
		# still log in with a local Windmill account afterwards. Two
		# logins, permanently. That is the trade, not a misconfiguration.
		#
		# 🚨 IN-FLEET CALLERS MUST NOT USE THIS VHOST. Windmill's whole
		# point is POST /api/w/<ws>/jobs/run/* from other services, and
		# forward auth 302s every one of them. The alternative — an
		# Authentik "Unauthenticated URL" carve-out for ^/api/.* — would
		# expose the entire authenticated API to anyone who can reach the
		# name, since Windmill's own workspace tokens would then be the
		# only control. So: browsers come here, machines call
		# 127.0.0.1:10253 (or windmill_server:8000 on the bridge) direct.
		#
		# ⚠ Never set `disable_password_login` in Instance Settings. Its
		# description ("use when you only want OAuth/SAML logins") reads
		# like advice; with no OAuth provider configured — which is the
		# permanent state on OSS — it is a self-lockout switch.
		import protected
		reverse_proxy localhost:10253
	}

	# ------------------------------------------------------------------
	# Notes/Sync stack (stacks/notes-sync, ports 10200-10201). Syncthing's
	# BEP port 22000 has no route on purpose: it is not HTTP, and peers
	# reach it through the bare publish rather than through Caddy.
	# ------------------------------------------------------------------

	@rmfakecloud host rmfakecloud.svc.idanreed.com
	handle @rmfakecloud {
		# NO forward auth, and this one is not close. The tablet is a
		# non-interactive client holding an rmfakecloud-issued JWT and it
		# cannot follow a 302. Its routes are /discovery/v1/*,
		# /token/json/2/*, /service/json/1/*, /document-storage/json/2/*,
		# /sync/v{2,3,4}/*, /notifications/ws/json/1, /mqtt,
		# /integrations/v{1,2}/* and about thirty more — essentially the
		# whole application. Only /ui/* is a browser path, so the
		# exclusion list would not merely reopen the data plane, it would
		# BE the data plane.
		#
		# rmfakecloud authenticates itself: argon2id password hashing,
		# JWT with an admin claim, guarding /ui/api/*.
		#
		# 🚨 Do not enable this route before notes-sync-init has run. On
		# an empty data directory the first POST to /ui/api/login creates
		# an admin out of whatever credentials arrive, and there is no
		# switch that closes that window.
		#
		# Websockets on /notifications/ws/json/1; Caddy upgrades with no
		# extra configuration.
		reverse_proxy localhost:10200
	}

	@syncthing host syncthing.svc.idanreed.com
	handle @syncthing {
		# Forward auth on the GUI, and Syncthing keeps its own seeded
		# credential underneath — the API key is a full-admin bypass, so
		# anything that reaches the port directly must still meet a lock.
		#
		# Rollout order is load-bearing as always: the blueprint entry in
		# headscale-vps/authentik/blueprints/custom/forward-auth.yaml plus
		# a VPS rebuild BEFORE this route syncs.
		#
		# ⚠ This route only works because the container keeps
		# STGUIADDRESS=0.0.0.0:8384. Upstream's README tells you to unset
		# it so the GUI binds 127.0.0.1, which installs lib/api's
		# localhostMiddleware — after which every request arriving with
		# this Host gets a bare 403 "Host check error" and nothing in the
		# logs explains it. That is finding #15 in a different coat.
		#
		# Do NOT let a client-supplied X-API-Key through: it bypasses GUI
		# auth entirely. Caddy forwards unknown headers by default, so
		# strip it here rather than relying on forward auth to stop it.
		request_header -X-API-Key
		import protected
		reverse_proxy localhost:10201
	}

	# ------------------------------------------------------------------
	# Vaultwarden (Util range, 10400 — its own stack, see
	# stacks/vaultwarden/compose.yaml for why).
	#
	# This is the only route in the fleet where forward auth is applied to
	# ONE PATH rather than to the host, and both halves of that are
	# deliberate.
	# ------------------------------------------------------------------

	@vaultwarden host vaultwarden.svc.idanreed.com
	handle @vaultwarden {
		# /admin gets forward auth AND keeps its ADMIN_TOKEN. Upstream
		# offers DISABLE_ADMIN_TOKEN for exactly this arrangement — "only
		# meant to be used with the use of a separate auth layer in
		# front" — and it is deliberately NOT set: with both, a
		# forward-auth outage still leaves the token, and a leaked token
		# still needs an Authentik session. It fails closed in both
		# directions.
		@vaultwarden-admin path /admin*
		handle @vaultwarden-admin {
			import protected
			reverse_proxy localhost:10400
		}

		# Everything else gets NO forward auth, and this one is not a
		# preference. The browser extension, the mobile and desktop apps
		# and the CLI all authenticate with a bearer token against
		# /identity/connect/token and /api/*; none of them can follow a
		# 302 to Authentik and they surface it as a generic login
		# failure. The notification websocket (/notifications/hub, and
		# /notifications/anonymous-hub for Send links) is on this same
		# port, and a forward-auth 302 on an Upgrade request makes every
		# client fall back to polling SILENTLY — the symptom is "my vault
		# takes minutes to sync", not an error.
		#
		# The exclusion list needed to fix all that would be the entire
		# data plane, which is the same finding as Dawarich and Kavita.
		# And Vaultwarden's own auth is stronger here anyway: the vault
		# is end-to-end encrypted under the master key, so Authentik in
		# front would add a perimeter around ciphertext.
		handle {
			reverse_proxy localhost:10400
		}
	}

	# Anything not matched above. Without this a stray subdomain would get a
	# blank 200 from the wildcard site.
	handle {
		respond "No such service" 404
	}
}
