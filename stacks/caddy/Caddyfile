# Reverse proxy for the services VM.
#
# Bound to the tailnet IP only — nothing here is reachable from the LAN or the
# internet — with certificates from Let's Encrypt over DNS-01, because
# HTTP-01 cannot reach a tailnet-only host. ONE wildcard certificate for
# *.svc.idanreed.com: per-hostname certs would publish every internal service
# name to the public Certificate Transparency logs.
#
# *.svc.idanreed.com is a public Cloudflare A record pointing at this host's
# tailnet IP, which is CGNAT space and only routable from inside the tailnet.

# ---------------------------------------------------------------------------
# Forward auth
# ---------------------------------------------------------------------------
# Import into a handle block to put Authentik in front of a service with no
# usable auth of its own. Defined BEFORE the site block because Caddy resolves
# `import` while parsing.
#
# The hop rides the TAILNET, not the public route, and that is load-bearing:
# the outpost routes forward-auth requests BY X-Forwarded-Host, and any Caddy
# rewrites that header unless the source is a trusted proxy. Dialled publicly,
# the VPS Caddy would see our home IP, rewrite the header to auth.idanreed.com
# and 404 every check.
#
# 🚨 PER-SERVICE LOCKOUT HAZARD: importing this into a handle whose external
# host has no provider entry in
# headscale-vps/authentik/blueprints/custom/forward-auth.yaml leaves the
# outpost nothing to match, and every request 404s or redirect-loops.
# Blueprint entry + VPS deploy FIRST, then flip the import here.
#
# ⚠ The client-supplied `X-Authentik-*` strip is SITE-LEVEL below and must
# be: caddy's directiveOrder runs `request_header` after `forward_auth`, so a
# strip beside this one would delete exactly the headers the outpost just
# copied in. A `route` wrapper would fix the order but re-indent this block,
# which tests/suites/forward-auth.nix anchors on.
(protected) {
	forward_auth https://headscale-vps.tailnet.idanreed.com {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
		header_up Host auth.idanreed.com
		transport http {
			tls_server_name auth.idanreed.com
		}
	}
}

*.svc.idanreed.com {
	bind {$TAILNET_IP}

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# 🚨 Nothing outside this proxy may ASSERT an Authentik identity —
	# including on routes added later by someone who never read this line.
	#
	# SITE LEVEL, not inside `(protected)`: directiveOrder puts
	# `request_header` after `forward_auth`, so beside the snippet it would
	# delete the outpost's own headers; here it only has to beat `handle`.
	#
	# The five names in copy_headers were never the hole — that expands into
	# an unconditional strip already. What this closes is the rest of the
	# family (X-authentik-jwt, X-authentik-meta-*, which nothing consumes
	# today and which forwarded verbatim), the order dependence, and the
	# UNPROTECTED routes, where nothing was stripping anything at all. `*` is
	# a real case-insensitive prefix wildcard.
	request_header -X-Authentik-*

	@komodo host komodo.svc.idanreed.com
	handle @komodo {
		# 🚨 The largest blast radius in this file: Core's UI drives
		# Periphery, which mounts the docker socket, so this is a
		# root-equivalent interface for the host. Komodo's own local login
		# stays underneath, so it fails closed either way.
		#
		# Rollout order is not optional here, because the thing you would
		# normally use to fix a broken deploy IS Komodo. If it does lock out,
		# recovery is `curl localhost:10000` over SSH or `nixos-rebuild
		# switch --target-host`, neither of which goes through Caddy.
		#
		# Fully protected, no /listener exemption: redeploy webhooks run
		# Forgejo -> Core over loopback and never traverse Caddy.
		import protected
		reverse_proxy localhost:10000
	}

	@paperless host paperless.svc.idanreed.com
	handle @paperless {
		reverse_proxy localhost:10100
	}

	@immich host immich.svc.idanreed.com
	handle @immich {
		# Native OIDC. NO forward auth: it would break the mobile app's
		# app.immich:// OAuth handoff and every x-api-key client.
		reverse_proxy localhost:10102
	}

	@backrest host backrest.svc.idanreed.com
	handle @backrest {
		reverse_proxy localhost:10002
	}

	@ntfy host ntfy.svc.idanreed.com
	handle @ntfy {
		reverse_proxy localhost:10001
	}

	@bentopdf host bentopdf.svc.idanreed.com
	handle @bentopdf {
		# Forward-auth PILOT: bentopdf has no auth of its own. Covered by
		# tests/suites/forward-auth.nix.
		import protected
		reverse_proxy localhost:10401
	}

	@mazanoke host mazanoke.svc.idanreed.com
	handle @mazanoke {
		# Forward auth, matching its _overview.md row and its sibling
		# bentopdf. Mazanoke is a client-side image optimiser with no auth
		# of its own, so this is the only lock it can have.
		import protected
		reverse_proxy localhost:10403
	}

	@glance host glance.svc.idanreed.com
	handle @glance {
		# Forward auth, and Glance's OWN login stays off in glance.yml so
		# this is the only lock — one login instead of two on a
		# browser-only dashboard. It also avoids a sharp edge: Glance
		# blocks an IP after 5 failed logins in 5 minutes, and behind a
		# loopback publish every request arrives from the docker bridge
		# gateway, so with its auth on and `server.proxied` off the first
		# five typos would lock out everyone at once.
		import protected
		reverse_proxy localhost:10402
	}

	@it-tools host it-tools.svc.idanreed.com
	handle @it-tools {
		# Forward auth is the only auth this can ever have — a static
		# nginx SPA with no accounts and no state, exactly like bentopdf.
		import protected
		reverse_proxy localhost:10407
	}

	@excalidraw host excalidraw.svc.idanreed.com
	handle @excalidraw {
		# NO forward auth — the outline/tandoor posture: AstraDraw has real
		# auth of its own (seeded local admin, registration OFF in its
		# compose) and native OIDC against Authentik, ready-but-off until
		# the client secret lands. An outpost in front would add a second
		# login and 302 the collab websocket's reconnect on session expiry
		# (the grafana/owl interplay) for no auth gain. The room relay is
		# unauthenticated BY DESIGN, as upstream excalidraw-room is: joining
		# needs the room id AND its E2E key, which travels in the URL
		# fragment and never reaches any server.
		# One origin, three upstreams — mirrors upstream's Traefik layout.
		@excalidraw-collab path /socket.io/*
		handle @excalidraw-collab {
			# Websockets: Caddy upgrades automatically, nothing extra.
			reverse_proxy localhost:10408
		}
		@excalidraw-api path /api/v2/*
		handle @excalidraw-api {
			reverse_proxy localhost:10409
		}
		handle {
			reverse_proxy localhost:10406
		}
	}

	@forgejo host forgejo.svc.idanreed.com
	handle @forgejo {
		# Web UI AND git-over-https (the v1 access mode — ssh is deferred, see
		# stacks/forgejo/compose.yaml). Forgejo has its own auth: web sessions
		# for the UI, tokens for git — no forward auth in front of it, which
		# also keeps non-browser git clients working.
		reverse_proxy localhost:10550
	}

	# ------------------------------------------------------------------
	# Media stack (stacks/media, 10050-10058). qBittorrent has NO route
	# yet, deliberately: _overview marks it FwdAuth and its blueprint
	# entry does not exist, so flipping the route live first is the
	# lockout hazard described above. Add both together.
	# ------------------------------------------------------------------

	@jellyfin host jellyfin.svc.idanreed.com
	handle @jellyfin {
		# Jellyfin's own login plus the SSO-Auth plugin's Authentik button
		# (native OIDC, jellyfin-oidc.yaml). NO forward auth: it would break
		# every native client app.
		reverse_proxy localhost:10050
	}

