# Penpot — the keys stored in secrets.sops.json, one value each (`sopsgen
# apply` fills generated ones, `sopsedit` the rest). Values built from other
# secrets live in env.nix. Key set must match secrets.sops.json and
# tests/fixtures/stacks/penpot.sops.json.

# Postgres
# Read by the postgres image at first initdb; the backend gets it as
# PENPOT_DATABASE_PASSWORD (env.nix). Rotating means an ALTER USER in the
# container as well. openssl rand -hex 32
POSTGRES_PASSWORD=changeme_hex32

# Master key
# Penpot derives its session, invitation and exporter keys from it; backend and
# exporter must hold the same value. Rotating logs everyone out and voids open
# invitations. openssl rand -hex 64
PENPOT_SECRET_KEY=changeme_hex64
