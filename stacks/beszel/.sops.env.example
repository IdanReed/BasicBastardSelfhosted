# Beszel application secrets — template. The real file is .sops.env
# (sops-encrypted dotenv), decrypted on the host into .env by
# decrypt-sops-envs.service and read through `env_file`.
#
# 🚨 QUOTING: a value containing `$` MUST be single-quoted. The decrypt path
# sources these, and Compose interpolates env_file values too (finding #30) —
# verified empirically: single-quoted passes through intact, bare and
# double-quoted get mangled. None of the values below should need it if the
# generation commands here are used, but a hand-picked password might.
#
# ---------------------------------------------------------------------------
# THE KEY / TOKEN TRIANGLE — get this wrong and the agent restart-loops.
# ---------------------------------------------------------------------------
# The token did NOT replace the SSH key; you need both, and they interlock:
#
#   1. the agent dials the hub with `X-Token: $TOKEN`
#   2. the hub validates it, then SIGNS the token string with its own ed25519
#      key (the one at /mnt/fast/beszel/id_ed25519)
#   3. the agent verifies that signature against $KEY
#   4. the agent returns its fingerprint; the hub pins it on first connect
#
# So HUB_SSH_KEY_B64 and KEY must be the two halves of ONE keypair, and TOKEN
# must be the same string here as in the config.yml beszel-init generates from
# it. Generate all three in one go:
#
#   ssh-keygen -q -t ed25519 -N '' -C beszel-hub -f /tmp/beszel_hub
#   echo "HUB_SSH_KEY_B64=$(base64 -w0 /tmp/beszel_hub)"
#   echo "KEY=$(cat /tmp/beszel_hub.pub)"
#   echo "TOKEN=$(cat /proc/sys/kernel/random/uuid)"
#   shred -u /tmp/beszel_hub /tmp/beszel_hub.pub
#
# Base64 for the private half because this is a DOTENV file and an OpenSSH PEM
# is multi-line. beszel-init decodes it and writes /mnt/fast/beszel/id_ed25519
# with mode 0600 before the hub starts.
#
# 🚨 Do NOT let the hub generate its own key by leaving this unset. It writes
# no .pub file and keeps the public half in memory only, so the matching KEY
# is unrecoverable from the host afterwards — the pair would have to be reset
# by deleting the key and restarting. beszel-init refuses to let the hub start
# without it for exactly this reason.
HUB_SSH_KEY_B64=changeme_base64_of_the_hub_ed25519_private_key
KEY=changeme_ssh-ed25519_public_half_of_the_same_pair
TOKEN=changeme-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# First-run superuser.
# ---------------------------------------------------------------------------
# 🚨 Read inside a one-shot PocketBase migration, so these take effect ONLY
# against a virgin data.db — setting or changing them on an existing install
# does nothing. And if only ONE of the two is set, Beszel creates a temporary
# superuser `_@b.b` with a random password instead and the browser first-run
# form becomes the only way in. Set both, or neither.
#
# The idempotent repair path once the migration has fired is the PocketBase
# CLI (0.39.11 renamed `admin` to `superuser`), which needs no --dir because
# the image's WorkingDir is / and DefaultDataDir is beszel_data:
#
#   docker compose -f /srv/stacks/beszel/compose.yaml -p beszel \
#     run --rm --entrypoint /beszel beszel superuser upsert <email> <password>
#
# This login stays underneath forward auth, the Arcane arrangement — so the
# stack fails closed either way. Beszel's own OIDC is NOT usable here: the
# provider config lives in the users collection's oauth2 options inside
# data.db and there are no environment variables for any of it, i.e. it is a
# browser wizard. _overview's row says FwdAuth for that reason.
USER_EMAIL=changeme@example.com
USER_PASSWORD=changeme_long_random_password

# ---------------------------------------------------------------------------
# Agent: the root filesystem to report I/O for.
# ---------------------------------------------------------------------------
# 🚨 A WRONG value here does not fail — it reports ZERO. Verified against
# v0.18.8 (finding #44): with FILESYSTEM naming a device that does not exist,
# the agent logs ONE line —
#
#   WARN Partition details not found filesystem=vda
#
# — connects normally, reports `healthy`, and then publishes `d: 0, du: 0` for
# the root disk forever. The dashboard shows a 0 GB disk, not an error. With
# the correct value the same agent reported `d: 3665.96, du: 114.89`. A
# monitoring stack that silently reports zero disk usage is worse than no
# monitoring stack, so tests/suites/beszel.nix asserts d > 0 rather than
# trusting the agent's own health.
#
# (Unset is a different, louder case: root-fs autodetection picks the overlay
# and logs `Root I/O device not detected; set FILESYSTEM to override`.)
#
# Find the right value on the host with:
#
#   findmnt -no SOURCE /      # e.g. /dev/nvme0n1p2 -> FILESYSTEM=nvme0n1p2
#
# The two DATA tiers do not come from here — they are the /extra-filesystems
# binds in compose.yaml, which is what actually delivers the disk-trend
# warning this stack exists for.
FILESYSTEM=changeme_root_block_device_basename
