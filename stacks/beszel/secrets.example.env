# Beszel — the keys stored in secrets.sops.json, one value each (`sopsgen
# apply` fills generated ones, `sopsedit` the rest). Values built from other
# secrets live in env.nix. Key set must match secrets.sops.json and
# tests/fixtures/stacks/beszel.sops.json.

# Hub keypair
# HUB_SSH_KEY_B64 and KEY are the two halves of ONE pair and TOKEN must match
# the config.yml beszel-init generates; the agent verifies the hub's signature
# over TOKEN against KEY, so a mismatch restart-loops the agent. Do NOT let the
# hub generate its own key — it keeps the public half in memory only.
#   ssh-keygen -q -t ed25519 -N '' -C beszel-hub -f /tmp/beszel_hub
#   HUB_SSH_KEY_B64=$(base64 -w0 /tmp/beszel_hub); KEY=$(cat /tmp/beszel_hub.pub)
#   TOKEN=$(cat /proc/sys/kernel/random/uuid); shred -u /tmp/beszel_hub*
HUB_SSH_KEY_B64=changeme_base64_of_hub_ed25519_private_key
KEY=changeme_ssh_ed25519_public_half_of_the_same_pair
TOKEN=changeme-0000-0000-0000-000000000000

# First-run superuser
# Read inside a one-shot PocketBase migration: they take effect against a
# VIRGIN data.db only, and setting just ONE of the two makes Beszel create a
# random `_@b.b` superuser instead. Repair path afterwards:
#   docker compose -f /srv/komodo/stacks/beszel/stacks/beszel/compose.yaml -p beszel \
#     run --rm --entrypoint /beszel beszel superuser upsert <email> <password>
USER_EMAIL=changeme@example.com

# Agent filesystem
# The root block device to report I/O for. A WRONG value does not fail — the
# agent logs one WARN, reports healthy, and publishes 0 GB forever.
# findmnt -no SOURCE /     # /dev/nvme0n1p2 -> nvme0n1p2
FILESYSTEM=changeme_root_block_device_basename
