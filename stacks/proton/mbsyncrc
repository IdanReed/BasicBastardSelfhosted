# mbsync config for the proton-export sidecar — mounted :ro at /mbsyncrc, the
# path the image's /sync helper hardcodes. ARCHIVE semantics throughout: one-way
# pull, no expunge, no write-back. compose.yaml carries the design.

IMAPAccount proton
# The bridge by compose service name, not the host's 10004 publish, which a
# container on this network cannot reach anyway.
Host hydroxide
Port 1143
# From the compose environment, so the repo copy carries no account value.
# printenv, not `echo $VAR`: the command line stays expansion-free.
UserCmd "printenv PROTON_ACCOUNT"
PassCmd "printenv PROTON_BRIDGE_PASSWORD"
# hydroxide's IMAP is plaintext-only by design; this hop is
# container-to-container inside one compose project.
TLSType None
# 🚨 Load-bearing: with TLSType None the default `AuthMechs *` deems no password
# mechanism secure enough and refuses to authenticate at all.
AuthMechs LOGIN
# hydroxide's IMAP is upstream-flagged WIP; serialising trades speed for not
# exercising its concurrency edges. An archive pull has no latency budget.
PipelineDepth 1

IMAPStore proton-remote
Account proton

MaildirStore proton-archive
SubFolders Verbatim
# Trailing '/' is significant to mbsync.
Path /mail/
Inbox /mail/INBOX

Channel proton
Far :proton-remote:
Near :proton-archive:
Patterns *
# Create maildirs locally as folders appear server-side; never on the server.
Create Near
# 🚨 The archive contract: changes propagate ONLY far->near, and deletions are
# never executed locally — so the archive only grows and pruning is a deliberate
# manual act, never mbsync's.
Sync Pull
Expunge None
# State beside the mail itself, so the archive restores as one self-contained tree.
SyncState *
