# mbsync (isync 1.5.0) config for the proton-export sidecar — mounted :ro at
# /mbsyncrc (the image's fixed path; its /sync helper hardcodes it too).
# ARCHIVE semantics throughout: one-way pull, no expunge, no write-back.
# compose.yaml's header carries the design; this file only executes it.

IMAPAccount proton
# The bridge, by compose service name over the project's own bridge network —
# NOT the host's 10004 publish (a container on this network cannot reach a
# host loopback publish anyway).
Host hydroxide
Port 1143
# Both come from the compose-delivered environment (.sops.env -> .env ->
# env_file), so the repo copy of this file carries no account-specific value.
# printenv, not `echo $VAR`: the command line itself stays expansion-free.
UserCmd "printenv PROTON_ACCOUNT"
PassCmd "printenv PROTON_BRIDGE_PASSWORD"
# hydroxide's IMAP is plaintext-only by design (upstream README: "only
# supports unencrypted local connections"); this hop is container-to-container
# inside one compose project on one host.
TLSType None
# 🚨 Load-bearing: with TLSType None, the default `AuthMechs *` deems NO
# password mechanism secure enough and refuses to authenticate at all
# (isync 1.5 manpage: * = "mechanisms deemed secure enough for the current
# TLSType setting"). LOGIN must be allowed by name.
AuthMechs LOGIN
# hydroxide's IMAP is upstream-flagged WIP ("here be dragons"); serialising
# commands trades speed for not exercising its concurrency edges. An archive
# pull has no latency budget.
PipelineDepth 1

IMAPStore proton-remote
Account proton

MaildirStore proton-archive
SubFolders Verbatim
# Trailing '/' is significant to mbsync.
Path /mail/
Inbox /mail/INBOX

Channel proton
Far :proton-remote:
Near :proton-archive:
# Every folder, including the per-alias folders external-email.md's filter
# scheme sorts into.
Patterns *
# Create maildirs locally as folders appear server-side; never create
# anything ON the server.
Create Near
# 🚨 The archive contract, in two lines: changes propagate ONLY far->near
# (Sync Pull), and deletions are never executed locally (Expunge None) — a
# message deleted, or ransomed, server-side stays in the archive forever.
# Consequence to know: the archive only grows; pruning is a deliberate
# manual act, never mbsync's.
Sync Pull
Expunge None
# State beside the mail itself (.mbsyncstate in each maildir) — the archive
# directory is self-contained and restores as one tree.
SyncState *
