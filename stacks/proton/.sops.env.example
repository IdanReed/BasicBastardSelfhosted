# Proton — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/proton.sops.env.
# Only the export sidecar reads these (mbsyncrc UserCmd/PassCmd); hydroxide
# consumes no environment at all.

# Bridge
# The Proton account hydroxide was `auth`ed as; also the IMAP/SMTP username.
PROTON_ACCOUNT=changeme_proton_account_email
# Printed exactly ONCE by `docker exec -it hydroxide /app/hydroxide auth
# <account>` — it decrypts auth.json and is stored nowhere else. Lost: re-run
# the bootstrap auth and update this value.
PROTON_BRIDGE_PASSWORD=changeme_bridge_password
