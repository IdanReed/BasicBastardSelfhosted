# Proton stack secrets — template. Copy to .sops.env, fill, then
#   sops -e -i .sops.env
# (encryption needs only the public recipient in ../../.sops.yaml — no key,
# no sudo; `sopsedit stacks/proton/.sops.env` is the edit-in-place path).
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/proton.sops.env carry EXACTLY the same keys — the
# stack-env-drift lint fails on any difference.
#
# ONLY THE EXPORT SIDECAR reads these (mbsyncrc's UserCmd/PassCmd). The
# hydroxide container consumes NO environment at all: the Proton account
# password is deliberately never stored anywhere — it is typed once into
#   docker exec -it hydroxide /app/hydroxide auth <account>
# (compose.yaml, bootstrap section), which prints the bridge password that
# belongs below.
#
# 🚨 QUOTING: a value containing `$` MUST be single-quoted (finding #30 —
# compose interpolates env_file values). A real bridge password is base64
# (A-Za-z0-9+/=, never `$` — auth.GeneratePassword read at source), so it is
# safe unquoted; do not rely on that for any hand-edited value.

# The Proton account the bridge was `auth`ed as — an email address; also the
# IMAP/SMTP username every bridge client uses.
PROTON_ACCOUNT=changeme_proton_account_email

# Printed exactly ONCE by `hydroxide auth`. It is the decryption key for the
# credentials in /mnt/fast/proton/hydroxide/auth.json — hydroxide does not
# store it. Lost: re-run the bootstrap `auth` (it replaces the old entry)
# and update this value.
PROTON_BRIDGE_PASSWORD=changeme_bridge_password
