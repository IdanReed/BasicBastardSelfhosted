# Ghostfolio — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/ghostfolio.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).
# No REDIS_PASSWORD on purpose — redis runs unauthenticated on the project's
# private bridge; adding the variable without `requirepass` breaks the app.

# Token salt
# NEVER ROTATE. Ghostfolio accounts have no password — the only credential is a
# UUID security token, stored as SHA-256 of <token><ACCESS_TOKEN_SALT>. Change
# it and every account is locked out permanently, with no reset flow.
# openssl rand -hex 32
ACCESS_TOKEN_SALT=changeme_hex32

# Session
# Signs the JWTs the security token is exchanged for. Safe to rotate — the cost
# is that every browser has to present its token again. openssl rand -hex 32
JWT_SECRET_KEY=changeme_hex32

# Postgres
# One key, two readers: it initialises the role and compose interpolates it
# into DATABASE_URL. Rotating on an existing cluster also needs
# ALTER ROLE ghostfolio WITH PASSWORD ... . openssl rand -hex 24
POSTGRES_PASSWORD=changeme_hex24

# OIDC
# Twin of GHOSTFOLIO_OIDC_CLIENT_SECRET in headscale-vps/secrets.sops.yaml;
# read directly by ghostfolio via env_file. Filled by sops-gen.
# openssl rand -hex 32
OIDC_CLIENT_SECRET=changeme_hex32
