# Excalidraw (AstraDraw) stack secrets (services VM) — read by
# excalidraw_api and excalidraw_db via env_file.
# Copy to .sops.env and encrypt with:
#   sops -e -i .sops.env
# (encryption needs only the public key in .sops.yaml, so no sudo and no age
# key are required to create this file — only editing one afterwards is.)
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/excalidraw.sops.env must all carry EXACTLY the same keys —
# the stack-env-drift lint fails on any difference.
#
# Reminder from CLAUDE.md: any value containing '$' must be single-quoted in
# the plaintext before encrypting. None of these placeholders has one, and
# generating every value with `openssl rand -hex 32` keeps it that way —
# hex is also URL-safe, which STORAGE_URI needs (below).

# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD — the database superuser password, read by the postgres
# image at first initdb AND by the api's entrypoint (which builds Prisma's
# DATABASE_URL from it, URL-encoding it itself).
#
# 🚨 ROTATION IS A TWO-KEY LOCKSTEP: the SAME password is embedded in
# STORAGE_URI below, which is NOT derived — change one without the other and
# scene saves start failing while logins still work (Prisma and keyv connect
# separately). Also note postgres only READS this at first cluster init;
# changing it later means ALTER USER inside the container, then updating
# both keys here.
#
# Generate: openssl rand -hex 32
#   (hex on purpose: STORAGE_URI embeds this raw in a URL with NO encoding
#    layer, so characters like @ / : % + would corrupt the URI. Hex cannot.)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme_excalidraw_pg_password

# ---------------------------------------------------------------------------
# STORAGE_URI — the keyv connection string for scene-blob storage
# (STORAGE_BACKEND=keyv in compose.yaml). Same cluster, same credentials,
# 🚨 DIFFERENT DATABASE — excalidraw_storage, the one keyv-init.sql creates:
#   postgres://excalidraw:<POSTGRES_PASSWORD>@excalidraw_db:5432/excalidraw_storage
# Pointing it at `excalidraw` instead is not a tidy-up, it is data loss:
# Prisma's migrate-or-push entrypoint chain DROPS foreign tables from its
# own database on every boot (measured — see keyv-init.sql).
#
# 🚨 IF THIS KEY IS EVER MISSING the api does NOT fail — it logs one WARN
# and silently stores every scene in process MEMORY, lost on restart. That
# is why the suite writes a scene, restarts the api, and reads it back
# through Postgres rather than trusting a green healthcheck.
# ---------------------------------------------------------------------------
STORAGE_URI=postgres://excalidraw:changeme_excalidraw_pg_password@excalidraw_db:5432/excalidraw_storage

# ---------------------------------------------------------------------------
# JWT_SECRET — signs the astradraw_token session cookie. Rotating it logs
# everyone out; nothing at rest is encrypted with it (ROOM_KEY_SECRET below
# exists precisely so room keys do not depend on this one).
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=changeme_excalidraw_jwt_secret

# ---------------------------------------------------------------------------
# ROOM_KEY_SECRET — encrypts per-scene collaboration room keys at rest in
# the database (hashed with SHA-256 before use, so any length works). Set
# separately from JWT_SECRET so a session-key rotation does not invalidate
# every existing collab room. 🚨 Rotating THIS one does: scenes with
# auto-collaboration lose their room key and collab must be re-enabled per
# scene.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
ROOM_KEY_SECRET=changeme_excalidraw_room_key_secret

# ---------------------------------------------------------------------------
# ADMIN_PASSWORD — the seeded local admin's password (username `admin`, see
# compose.yaml). Read at every boot; changing it here and redeploying IS the
# password change. This account is the only way in until the OIDC client
# secret lands, and stays as the break-glass login afterwards.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=changeme_excalidraw_admin_password
