# Excalidraw (AstraDraw) — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/excalidraw.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).

# Postgres
# Read by the postgres image at first initdb and by the api's entrypoint. HEX
# on purpose: STORAGE_URI embeds it raw in a URL with no encoding layer.
# Rotating means changing STORAGE_URI in lockstep AND an ALTER USER in the
# container. openssl rand -hex 32
POSTGRES_PASSWORD=changeme_hex32
# keyv connection string for scene blobs. SAME cluster and credentials,
# DIFFERENT database (excalidraw_storage — see keyv-init.sql; pointing it at
# `excalidraw` is data loss). If this key goes MISSING the api logs one WARN
# and stores every scene in memory.
STORAGE_URI=postgres://excalidraw:changeme_hex32@excalidraw_db:5432/excalidraw_storage

# Session
# Signs the astradraw_token cookie; rotating logs everyone out and nothing more.
# openssl rand -hex 32
JWT_SECRET=changeme_hex32
# Encrypts per-scene collab room keys at rest — separate from JWT_SECRET so a
# session rotation does not kill every collab room. Rotating THIS one does.
# openssl rand -hex 32
ROOM_KEY_SECRET=changeme_hex32

# Local admin
# Username `admin` (compose.yaml). Read at every boot, so changing it here and
# redeploying IS the password change. Break-glass login once OIDC is on.
ADMIN_PASSWORD=changeme_strong_password

# OIDC
# Twin of EXCALIDRAW_OIDC_CLIENT_SECRET in headscale-vps/secrets.sops.yaml.
# OIDC ships OFF in compose (unmeasured alpha) — staged for the operator flip.
# Filled by sops-gen. openssl rand -hex 32
OIDC_CLIENT_SECRET=changeme_hex32
