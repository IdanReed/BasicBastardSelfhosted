# Dawarich stack secrets (services VM) — app, sidekiq, PostGIS, redis
# Copy to .sops.env and encrypt with:
#   SOPS_AGE_KEY_FILE=../../sops_age_key.txt sops -e -i .sops.env
#
# Key-set contract: this file, the real .sops.env and the test fixture
# tests/fixtures/dawarich.sops.env must all carry EXACTLY the same keys — the
# stack-env-drift lint fails on any difference.
#
# Reminder from CLAUDE.md: any value containing '$' must be single-quoted in
# the plaintext before encrypting — the decrypt-and-source path expands it
# otherwise.
#
# ⚠ ONE OF THESE MUST NEVER BE ROTATED once the stack has data, and its
# failure mode is SILENT. See SECRET_KEY_BASE below.

# ---------------------------------------------------------------------------
# Rails
#
# ⚠ SECRET_KEY_BASE — NEVER ROTATE. config/application.rb derives the
# ActiveRecord encryption keys from it whenever the OTP_ENCRYPTION_* variables
# are absent (which they are here), so rotating it makes every encrypted
# attribute undecryptable: 2FA secrets and stored geocoding credentials. That
# alone would be bad enough, but Geocoding::Config catches the failure and
# only LOGS A WARNING, then treats geocoding as disabled — so the damage
# announces itself as a feature quietly not working.
#
# It is also REQUIRED FOR BOOT, including by the init container: without it
# application.rb raises "OTP_ENCRYPTION_PRIMARY_KEY required in production",
# which names a variable you never set and did not know existed.
# Generate: openssl rand -hex 64
# ---------------------------------------------------------------------------
SECRET_KEY_BASE=changeme_openssl_rand_hex_64

# ---------------------------------------------------------------------------
# PostGIS. Both spellings hold the SAME value: POSTGRES_PASSWORD initialises
# the role in the database container, DATABASE_PASSWORD is what Rails connects
# with (config/database.yml reads the discrete DATABASE_* variables, not
# DATABASE_URL — the URL parsing upstream advertises lives in the entrypoint
# scripts, and the init container skips those).
# Generate: openssl rand -hex 24
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme_openssl_rand_hex_24
DATABASE_PASSWORD=changeme_same_value_as_POSTGRES_PASSWORD

# ---------------------------------------------------------------------------
# The admin account.
#
# 🚨 THIS IS NOT OPTIONAL BOILERPLATE. db/seeds.rb creates
# demo@dawarich.app / safepassword as an ACTIVE ADMIN, guarded only by
# `User.none?`, and the app's entrypoint runs `rails db:seed` on every boot.
# There is no upstream env var to change that email or password, and
# POST /api/v1/auth/register creates a NON-admin user so it cannot replace it.
# dawarich_init renames the seeded account in place using these two values —
# leave them unset and it exits non-zero rather than leaving a
# published-password admin on your location history.
#
# The password must be at least 12 characters (dawarich-init.rb's own floor;
# Devise would accept 6).
# Generate: openssl rand -base64 24
# ---------------------------------------------------------------------------
DAWARICH_ADMIN_EMAIL=idan@idanreed.com
DAWARICH_ADMIN_PASSWORD=changeme_strong_password

# ---------------------------------------------------------------------------
# OIDC client secret — LEAVE EMPTY until the Authentik side exists.
#
# Empty is a complete state, not a placeholder: with OIDC_ISSUER /
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET unset the app warns once and falls back
# to email/password, exactly like Kavita and audiobookshelf in the books
# stack. Redirect URI when it is turned on:
#   https://dawarich.svc.idanreed.com/users/auth/openid_connect/callback
#
# ⚠ Dawarich must NEVER be put behind forward auth instead — its tracker
# clients pass an API key in the query string and cannot follow a redirect,
# so the exclusion list would be the entire data plane.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
DAWARICH_OIDC_CLIENT_SECRET=
