# Dawarich — template for .sops.env. Fill, then: sops -e -i .sops.env
# Key set must match the real .sops.env and tests/fixtures/dawarich.sops.env.
# A value containing '$' MUST be single-quoted (compose interpolates env_file).

# Rails
# NEVER ROTATE: application.rb derives the ActiveRecord encryption keys from it
# (2FA secrets, stored geocoding credentials) and the failure is a logged
# warning, not an error. Also required for boot, including the init container.
# openssl rand -hex 64
SECRET_KEY_BASE=changeme_hex64

# PostGIS
# Both spellings hold the SAME value: POSTGRES_PASSWORD initialises the role,
# DATABASE_PASSWORD is what Rails connects with. openssl rand -hex 24
POSTGRES_PASSWORD=changeme_hex24
DATABASE_PASSWORD=changeme_same_value_as_POSTGRES_PASSWORD

# Admin
# NOT boilerplate: db/seeds.rb creates demo@dawarich.app / safepassword as an
# ACTIVE ADMIN on every boot and there is no env var to change it — dawarich_init
# renames it in place from these, or exits non-zero. Password >= 12 chars.
# openssl rand -base64 24
DAWARICH_ADMIN_EMAIL=idan@idanreed.com
DAWARICH_ADMIN_PASSWORD=changeme_strong_password

# OIDC
# EMPTY is a complete state (the app warns once and falls back to
# email/password). Twin of DAWARICH_OIDC_CLIENT_SECRET in
# headscale-vps/secrets.sops.yaml. Never put Dawarich behind forward auth —
# tracker clients pass an API key in the query string. openssl rand -hex 32
DAWARICH_OIDC_CLIENT_SECRET=
